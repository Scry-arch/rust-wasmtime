test interpret
test run
target scry32

; Irreducible control flow: a cycle with two entry points, so it has no single
; header and cannot be described by structured loops.
;

; ---------------------------------------------------------------------------
; The classic two-block irreducible loop. block1 and block2 form a cycle that
; the entry can jump into at either block, so neither dominates the other.
;
;   block0 --+--> block1 <--+
;            |       |      |
;            |       v      |
;            +--> block2 ---+
;                    |
;                    v
;                  block3
; ---------------------------------------------------------------------------
function %irreducible2(i32 sext, i32 sext) -> i32 sext {
block0(v0: i32, v1: i32):                        ; entry_sel, n
    v2 = iconst.i32 0
    brif v0, block1(v1, v2), block2(v1, v2)

block1(v3: i32, v4: i32):
    v12 = iconst.i32 1
    v5 = iadd v4, v12
    v13 = iconst.i32 -1
    v6 = iadd v3, v13
    jump block2(v6, v5)

block2(v7: i32, v8: i32):
    v14 = iconst.i32 10
    v9 = iadd v8, v14
    v15 = iconst.i32 0
    v10 = icmp sgt v7, v15
    brif v10, block1(v7, v9), block3(v9)

block3(v11: i32):
    return v11
}

; run: %irreducible2(1, 2) == 22
; run: %irreducible2(0, 2) == 32
; run: %irreducible2(1, 0) == 11
; run: %irreducible2(0, 0) == 10

; ---------------------------------------------------------------------------
; An irreducible cycle whose two entries come from inside another loop, so an
; irreducible region is nested in a reducible one.
; ---------------------------------------------------------------------------
function %irreducible_nested(i32 sext, i32 sext) -> i32 sext {
block0(v0: i32, v1: i32):                        ; n, sel
    v2 = iconst.i32 0
    jump block1(v0, v1, v2)                      ; i, sel, acc

block1(v3: i32, v4: i32, v5: i32):               ; outer header
    v26 = iconst.i32 0
    v6 = icmp sgt v3, v26
    brif v6, block2(v3, v4, v5), block5(v5)

block2(v7: i32, v8: i32, v9: i32):               ; enters the cycle at either end
    v27 = iconst.i32 0
    v10 = icmp sgt v8, v27
    brif v10, block3(v7, v8, v9), block4(v7, v8, v9)

block3(v11: i32, v12: i32, v13: i32):            ; cycle node A
    v28 = iconst.i32 1
    v14 = iadd v13, v28
    v29 = iconst.i32 -1
    v15 = iadd v12, v29
    jump block4(v11, v15, v14)

block4(v16: i32, v17: i32, v18: i32):            ; cycle node B
    v30 = iconst.i32 2
    v19 = iadd v18, v30
    v31 = iconst.i32 0
    v20 = icmp sgt v17, v31
    brif v20, block3(v16, v17, v19), block6(v16, v17, v19)

block6(v21: i32, v22: i32, v23: i32):            ; outer latch
    v32 = iconst.i32 -1
    v24 = iadd v21, v32
    jump block1(v24, v22, v23)

block5(v25: i32):
    return v25
}

; run: %irreducible_nested(1, 0) == 2
; run: %irreducible_nested(1, 1) == 3
; run: %irreducible_nested(1, 2) == 6
; run: %irreducible_nested(2, 0) == 4
; run: %irreducible_nested(0, 3) == 0
; run: %irreducible_nested(2, 2) == 8
