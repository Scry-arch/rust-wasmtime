test interpret
test run
target scry32

; Joins with more than two predecessors.
;

; ---------------------------------------------------------------------------
; Three paths into one join. The join's predecessors sit at two different
; nesting depths, and one of them (block2) reaches the join by falling through
; rather than by an explicit jump.
;
;   block0 --> block1 --\
;      |                 v
;      +---> block2 --> block4
;              |         ^
;              +-> block3
; ---------------------------------------------------------------------------
function %merge3(i32 sext, i32 sext, i32 sext) -> i32 sext {
block0(v0: i32, v1: i32, v2: i32):
    brif v0, block1(v2), block2(v1, v2)

block1(v3: i32):
    v10 = iconst.i32 1
    v4 = iadd v3, v10
    jump block4(v4)

block2(v5: i32, v6: i32):
    brif v5, block3(v6), block4(v6)

block3(v7: i32):
    v11 = iconst.i32 2
    v8 = iadd v7, v11
    jump block4(v8)

block4(v9: i32):
    return v9
}

; run: %merge3(1, 0, 10) == 11
; run: %merge3(1, 1, 10) == 11
; run: %merge3(0, 1, 10) == 12
; run: %merge3(0, 0, 10) == 10
; run: %merge3(0, 0, -3) == -3

; ---------------------------------------------------------------------------
; Four paths into one join: a two-level branch tree whose four leaves all jump
; to the same block.
; ---------------------------------------------------------------------------
function %merge4(i32 sext, i32 sext, i32 sext) -> i32 sext {
block0(v0: i32, v1: i32, v2: i32):
    brif v0, block1(v1, v2), block2(v1, v2)

block1(v3: i32, v4: i32):
    brif v3, block3(v4), block4(v4)

block2(v5: i32, v6: i32):
    brif v5, block5(v6), block6(v6)

block3(v7: i32):
    v16 = iconst.i32 1
    v8 = iadd v7, v16
    jump block7(v8)

block4(v9: i32):
    v17 = iconst.i32 2
    v10 = iadd v9, v17
    jump block7(v10)

block5(v11: i32):
    v18 = iconst.i32 3
    v12 = iadd v11, v18
    jump block7(v12)

block6(v13: i32):
    v19 = iconst.i32 4
    v14 = iadd v13, v19
    jump block7(v14)

block7(v15: i32):
    return v15
}

; run: %merge4(1, 1, 0) == 1
; run: %merge4(1, 0, 0) == 2
; run: %merge4(0, 1, 0) == 3
; run: %merge4(0, 0, 0) == 4
; run: %merge4(1, 1, 100) == 101
; run: %merge4(0, 0, -4) == 0

; ---------------------------------------------------------------------------
; Three paths into one join, where the branching blocks have successors with
; different parameter counts. This combines the >2-way merge with the
; uneven-parameter handling.
; ---------------------------------------------------------------------------
function %merge3_uneven(i32 sext, i32 sext, i32 sext) -> i32 sext {
block0(v0: i32, v1: i32, v2: i32):
    brif v0, block1(v2), block2(v1, v2)   ; successors take 1 and 2 params

block1(v3: i32):
    v12 = iconst.i32 1
    v4 = iadd v3, v12
    jump block4(v4, v3)

block2(v5: i32, v6: i32):
    brif v5, block3(v6), block4(v6, v6)   ; successors take 1 and 2 params

block3(v7: i32):
    v13 = iconst.i32 2
    v8 = iadd v7, v13
    jump block4(v8, v7)

block4(v9: i32, v10: i32):
    v11 = iadd v9, v10
    return v11
}

; run: %merge3_uneven(1, 0, 10) == 21
; run: %merge3_uneven(0, 1, 10) == 22
; run: %merge3_uneven(0, 0, 10) == 20
; run: %merge3_uneven(1, 0, 0) == 1
; run: %merge3_uneven(0, 0, -5) == -10

; ---------------------------------------------------------------------------
; A join with three predecessors that is itself a branch, so the merged values
; immediately feed a conditional and then a second three-way merge.
; ---------------------------------------------------------------------------
function %merge3_then_branch(i32 sext, i32 sext, i32 sext) -> i32 sext {
block0(v0: i32, v1: i32, v2: i32):
    brif v0, block1(v2), block2(v1, v2)

block1(v3: i32):
    v16 = iconst.i32 1
    v4 = iadd v3, v16
    jump block4(v4)

block2(v5: i32, v6: i32):
    brif v5, block3(v6), block4(v6)

block3(v7: i32):
    v17 = iconst.i32 2
    v8 = iadd v7, v17
    jump block4(v8)

block4(v9: i32):                 ; three predecessors, and branches again
    v18 = iconst.i32 10
    v10 = icmp sgt v9, v18
    brif v10, block5(v9), block6(v9)

block5(v11: i32):
    v19 = iconst.i32 1000
    v12 = iadd v11, v19
    jump block7(v12)

block6(v13: i32):
    v20 = iconst.i32 2000
    v14 = iadd v13, v20
    jump block7(v14)

block7(v15: i32):
    return v15
}

; run: %merge3_then_branch(1, 0, 10) == 1011
; run: %merge3_then_branch(1, 0, 9) == 2010
; run: %merge3_then_branch(1, 0, 20) == 1021
; run: %merge3_then_branch(0, 1, 20) == 1022
; run: %merge3_then_branch(0, 0, 20) == 1020
; run: %merge3_then_branch(0, 0, 5) == 2005

; ---------------------------------------------------------------------------
; Five paths into one join, produced by a chain of if-without-else tests
; (an early-exit / short-circuit shape). Each escape jumps to the same block.
; ---------------------------------------------------------------------------
function %merge5_chain(i32 sext) -> i32 sext {
block0(v0: i32):
    v11 = iconst.i32 1
    v1 = icmp eq v0, v11
    brif v1, block5(v0), block1(v0)

block1(v2: i32):
    v12 = iconst.i32 2
    v3 = icmp eq v2, v12
    brif v3, block5(v2), block2(v2)

block2(v4: i32):
    v13 = iconst.i32 3
    v5 = icmp eq v4, v13
    brif v5, block5(v4), block3(v4)

block3(v6: i32):
    v14 = iconst.i32 4
    v7 = icmp eq v6, v14
    brif v7, block5(v6), block4(v6)

block4(v8: i32):
    v15 = iconst.i32 100
    v9 = iadd v8, v15
    jump block5(v9)

block5(v10: i32):
    return v10
}

; run: %merge5_chain(1) == 1
; run: %merge5_chain(2) == 2
; run: %merge5_chain(3) == 3
; run: %merge5_chain(4) == 4
; run: %merge5_chain(5) == 105
; run: %merge5_chain(0) == 100
