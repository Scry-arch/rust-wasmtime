test interpret
test run
target scry32

; Nested if-else structures: an if-else whose arms are themselves if-elses.

; ---------------------------------------------------------------------------
; Two levels, fully symmetric. Each inner if-else has its own join block, and
; the two inner joins merge in an outer join.
;
;            block0
;           /      \
;      block1       block4
;      /    \       /    \
;  block2 block3 block5 block6
;      \    /       \    /
;      block7       block8
;           \      /
;            block9
; ---------------------------------------------------------------------------
function %nested2(i32 sext, i32 sext, i32 sext) -> i32 sext {
block0(v0: i32, v1: i32, v2: i32):
    brif v0, block1(v1, v2), block4(v1, v2)

block1(v3: i32, v4: i32):
    brif v3, block2(v4), block3(v4)

block2(v5: i32):
    v20 = iconst.i32 1
    v6 = iadd v5, v20
    jump block7(v6)

block3(v7: i32):
    v21 = iconst.i32 2
    v8 = iadd v7, v21
    jump block7(v8)

block7(v9: i32):
    v22 = iconst.i32 100
    v10 = iadd v9, v22
    jump block9(v10)

block4(v11: i32, v12: i32):
    brif v11, block5(v12), block6(v12)

block5(v13: i32):
    v23 = iconst.i32 3
    v14 = iadd v13, v23
    jump block8(v14)

block6(v15: i32):
    v24 = iconst.i32 4
    v16 = iadd v15, v24
    jump block8(v16)

block8(v17: i32):
    v25 = iconst.i32 200
    v18 = iadd v17, v25
    jump block9(v18)

block9(v19: i32):
    return v19
}

; run: %nested2(1, 1, 0) == 101
; run: %nested2(1, 0, 0) == 102
; run: %nested2(0, 1, 0) == 203
; run: %nested2(0, 0, 0) == 204
; run: %nested2(1, 1, 10) == 111
; run: %nested2(0, 0, -204) == 0
; run: %nested2(-1, -1, 5) == 106

; ---------------------------------------------------------------------------
; Asymmetric nesting: only the "then" arm of the outer if-else contains a
; nested if-else. The "else" arm reaches the outer join directly, so the outer
; join has predecessors at two different nesting depths.
; ---------------------------------------------------------------------------
function %nested_asym(i32 sext, i32 sext, i32 sext) -> i32 sext {
block0(v0: i32, v1: i32, v2: i32):
    brif v0, block1(v1, v2), block5(v2)

block1(v3: i32, v4: i32):
    brif v3, block2(v4), block3(v4)

block2(v5: i32):
    v13 = iconst.i32 1
    v6 = iadd v5, v13
    jump block4(v6)

block3(v7: i32):
    v14 = iconst.i32 2
    v8 = iadd v7, v14
    jump block4(v8)

block4(v9: i32):
    v15 = iconst.i32 10
    v10 = iadd v9, v15
    jump block5(v10)

block5(v11: i32):
    v16 = iconst.i32 1000
    v12 = iadd v11, v16
    return v12
}

; run: %nested_asym(1, 1, 0) == 1011
; run: %nested_asym(1, 0, 0) == 1012
; run: %nested_asym(0, 1, 0) == 1000
; run: %nested_asym(0, 0, 7) == 1007
; run: %nested_asym(1, 1, -11) == 1000

; ---------------------------------------------------------------------------
; Three levels of nesting on the "then" side, with each level's else arm
; jumping straight out to a shared join. The condition of each level is
; computed inside the previous level rather than passed in, so the nesting also
; exercises values defined and consumed at different depths.
; ---------------------------------------------------------------------------
function %nested3(i32 sext) -> i32 sext {
block0(v0: i32):
    v15 = iconst.i32 0
    v1 = icmp sgt v0, v15
    brif v1, block1(v0), block6(v0)

block1(v2: i32):
    v16 = iconst.i32 10
    v3 = icmp sgt v2, v16
    brif v3, block2(v2), block5(v2)

block2(v4: i32):
    v17 = iconst.i32 100
    v5 = icmp sgt v4, v17
    brif v5, block3(v4), block4(v4)

block3(v6: i32):
    v18 = iconst.i32 3
    v7 = iadd v6, v18
    jump block7(v7)

block4(v8: i32):
    v19 = iconst.i32 2
    v9 = iadd v8, v19
    jump block7(v9)

block5(v10: i32):
    v20 = iconst.i32 1
    v11 = iadd v10, v20
    jump block7(v11)

block6(v12: i32):
    v21 = iconst.i32 0
    v13 = iadd v12, v21
    jump block7(v13)

block7(v14: i32):
    return v14
}

; run: %nested3(0) == 0
; run: %nested3(-5) == -5
; run: %nested3(1) == 2
; run: %nested3(10) == 11
; run: %nested3(11) == 13
; run: %nested3(100) == 102
; run: %nested3(101) == 104

; ---------------------------------------------------------------------------
; Nesting where a value produced before the outer branch is not used until
; after the outer join, so it must be threaded as a block parameter through
; every block of the nest alongside the values the nest actually computes.
; ---------------------------------------------------------------------------
function %nested_carry(i32 sext, i32 sext, i32 sext) -> i32 sext {
block0(v0: i32, v1: i32, v2: i32):
    v29 = iconst.i32 7
    v3 = iadd v2, v29            ; carried untouched through the whole nest
    brif v0, block1(v1, v2, v3), block4(v1, v2, v3)

block1(v4: i32, v5: i32, v6: i32):
    brif v4, block2(v5, v6), block3(v5, v6)

block2(v7: i32, v8: i32):
    v30 = iconst.i32 1
    v9 = iadd v7, v30
    jump block7(v9, v8)

block3(v10: i32, v11: i32):
    v31 = iconst.i32 2
    v12 = iadd v10, v31
    jump block7(v12, v11)

block7(v13: i32, v14: i32):
    jump block9(v13, v14)

block4(v15: i32, v16: i32, v17: i32):
    brif v15, block5(v16, v17), block6(v16, v17)

block5(v18: i32, v19: i32):
    v32 = iconst.i32 3
    v20 = iadd v18, v32
    jump block8(v20, v19)

block6(v21: i32, v22: i32):
    v33 = iconst.i32 4
    v23 = iadd v21, v33
    jump block8(v23, v22)

block8(v24: i32, v25: i32):
    jump block9(v24, v25)

block9(v26: i32, v27: i32):
    v28 = iadd v26, v27
    return v28
}

; run: %nested_carry(1, 1, 0) == 8
; run: %nested_carry(1, 0, 0) == 9
; run: %nested_carry(0, 1, 0) == 10
; run: %nested_carry(0, 0, 0) == 11
; run: %nested_carry(1, 1, 5) == 18
; run: %nested_carry(0, 0, -7) == -3
