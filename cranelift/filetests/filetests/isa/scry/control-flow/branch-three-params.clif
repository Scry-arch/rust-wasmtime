test interpret
test run
target scry32

; Successor blocks taking three parameters, exercising echo chains beyond the
; 2-output case. isub is not commutative, so wrong operand routing changes the
; result.

function %sum_or_diff(i32 sext, i32 sext, i32 sext) -> i32 sext {
block0(v0: i32, v1: i32, v2: i32):
    brif v0, block2(v0, v1, v2), block3(v0, v1, v2)

block2(v3: i32, v4: i32, v5: i32):
    v6 = iadd v3, v4
    v7 = iadd v6, v5
    jump block4(v7)

block3(v8: i32, v9: i32, v10: i32):
    v11 = isub v8, v9
    v12 = isub v11, v10
    jump block4(v12)

block4(v13: i32):
    return v13
}

; run: %sum_or_diff(0, 0, 0) == 0
; run: %sum_or_diff(0, 5, 3) == -8
; run: %sum_or_diff(1, 5, 3) == 9
; run: %sum_or_diff(-2, 10, 100) == 108
