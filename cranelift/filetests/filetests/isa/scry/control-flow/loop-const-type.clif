test interpret
test run
target scry32

; Tests type analysis by requiring that `iconst` has a known type in 
; the entry block, while the type knowledge comes from other blocks.
;

; ---------------------------------------------------------------------------
; A loop with two exits. The exit block is a join of the header's false arm and
; the body's break arm, so a single block is the successor of two different
; conditional blocks.
; ---------------------------------------------------------------------------
function %sum_break(i32 sext, i32 sext) -> i32 sext {
block0(v0: i32, v1: i32):                        ; n, limit
    v2 = iconst.i32 0
    jump block1(v0, v1, v2)                      ; i, limit, sum

block1(v3: i32, v4: i32, v5: i32):               ; header: while i > 0
    v6 = icmp_imm sgt v3, 0
    brif v6, block2(v3, v4, v5), block4(v5)

block2(v7: i32, v8: i32, v9: i32):               ; body: break if sum > limit
    v10 = icmp sgt v9, v8
    brif v10, block4(v9), block3(v7, v8, v9)

block3(v11: i32, v12: i32, v13: i32):            ; latch
    v14 = iadd_imm v11, -1
    v15 = iadd v13, v11
    jump block1(v14, v12, v15)

block4(v16: i32):                                ; exit, two predecessors
    return v16
}

; run: %sum_break(3, 100) == 6
; run: %sum_break(5, 100) == 15
; run: %sum_break(5, 4) == 5
; run: %sum_break(5, 0) == 5
; run: %sum_break(0, 10) == 0
; run: %sum_break(-1, 10) == 0

; ---------------------------------------------------------------------------
; A `continue` in the middle of a body: one arm skips the accumulate block and
; jumps straight to the latch, which therefore has two predecessors while the
; header still has two (entry + latch).
; ---------------------------------------------------------------------------
function %sum_small(i32 sext, i32 sext) -> i32 sext {
block0(v0: i32, v1: i32):                        ; n, cap
    v2 = iconst.i32 0
    jump block1(v0, v1, v2)                      ; i, cap, sum

block1(v3: i32, v4: i32, v5: i32):               ; header
    v6 = icmp_imm sgt v3, 0
    brif v6, block2(v3, v4, v5), block5(v5)

block2(v7: i32, v8: i32, v9: i32):               ; body: skip i when i > cap
    v10 = icmp sgt v7, v8
    v11 = iadd_imm v7, -1
    brif v10, block4(v11, v8, v9), block3(v11, v8, v9, v7)

block3(v12: i32, v13: i32, v14: i32, v15: i32):  ; accumulate
    v16 = iadd v14, v15
    jump block4(v12, v13, v16)

block4(v17: i32, v18: i32, v19: i32):            ; latch, two predecessors
    jump block1(v17, v18, v19)

block5(v20: i32):
    return v20
}

; run: %sum_small(5, 3) == 6
; run: %sum_small(5, 10) == 15
; run: %sum_small(5, 0) == 0
; run: %sum_small(0, 5) == 0
; run: %sum_small(1, 1) == 1

; ---------------------------------------------------------------------------
; A loop with three exits, all landing in the same block: the header test, an
; early break, and a late break. The exit block has three predecessors, each a
; conditional block inside or at the top of the loop.
; ---------------------------------------------------------------------------
function %three_exits(i32 sext, i32 sext) -> i32 sext {
block0(v0: i32, v1: i32):                        ; n, stop
    v2 = iconst.i32 0
    jump block1(v0, v1, v2)                      ; i, stop, acc

block1(v3: i32, v4: i32, v5: i32):               ; header (exit 1)
    v6 = icmp_imm sgt v3, 0
    brif v6, block2(v3, v4, v5), block4(v5)

block2(v7: i32, v8: i32, v9: i32):               ; early break (exit 2)
    v10 = icmp eq v7, v8
    v11 = iadd_imm v9, 1
    brif v10, block4(v11), block3(v7, v8, v11)

block3(v12: i32, v13: i32, v14: i32):            ; late break (exit 3) / latch
    v15 = icmp_imm sgt v14, 100
    v16 = iadd_imm v12, -1
    brif v15, block4(v14), block1(v16, v13, v14)

block4(v17: i32):                                ; exit, three predecessors
    return v17
}

; run: %three_exits(5, -1) == 5
; run: %three_exits(5, 3) == 3
; run: %three_exits(5, 5) == 1
; run: %three_exits(0, 0) == 0
; run: %three_exits(200, -1) == 101

; ---------------------------------------------------------------------------
; A loop inside one arm of an if-else. The block after the if-else joins the
; loop's exit with the arm that has no loop at all.
; ---------------------------------------------------------------------------
function %loop_in_branch(i32 sext, i32 sext) -> i32 sext {
block0(v0: i32, v1: i32):                        ; flag, n
    brif v0, block1(v1), block4(v1)

block1(v2: i32):                                 ; preheader
    v3 = iconst.i32 0
    jump block2(v2, v3)

block2(v4: i32, v5: i32):                        ; header
    v6 = icmp_imm sgt v4, 0
    brif v6, block3(v4, v5), block5(v5)

block3(v7: i32, v8: i32):                        ; latch
    v9 = iadd_imm v7, -1
    v10 = iadd v8, v7
    jump block2(v9, v10)

block4(v11: i32):                                ; the loop-free arm
    v12 = iadd_imm v11, 1000
    jump block5(v12)

block5(v13: i32):                                ; join of loop exit and arm
    return v13
}

; run: %loop_in_branch(1, 4) == 10
; run: %loop_in_branch(1, 0) == 0
; run: %loop_in_branch(0, 4) == 1004
; run: %loop_in_branch(0, 0) == 1000

; ---------------------------------------------------------------------------
; A `return` from inside the loop body, so the function has two returning
; blocks at different loop depths and the loop has no single exit.
; ---------------------------------------------------------------------------
function %return_in_loop(i32 sext, i32 sext) -> i32 sext {
block0(v0: i32, v1: i32):                        ; n, target
    v2 = iconst.i32 0
    jump block1(v0, v1, v2)                      ; i, target, acc

block1(v3: i32, v4: i32, v5: i32):               ; header
    v6 = icmp_imm sgt v3, 0
    brif v6, block2(v3, v4, v5), block4(v5)

block2(v7: i32, v8: i32, v9: i32):               ; body: return from inside
    v10 = iadd_imm v9, 1
    v11 = iadd_imm v7, -1
    v12 = icmp eq v10, v8
    brif v12, block3(v10), block1(v11, v8, v10)

block3(v13: i32):                                ; early return
    v14 = iadd_imm v13, 1000
    return v14

block4(v15: i32):                                ; normal return
    return v15
}

; run: %return_in_loop(5, 3) == 1003
; run: %return_in_loop(3, 1) == 1001
; run: %return_in_loop(5, 100) == 5
; run: %return_in_loop(0, 1) == 0

; ---------------------------------------------------------------------------
; Two loops joined into an outer cycle: loop A's exit is loop B's header, and
; loop B's latch jumps back into loop A's header. Block1 is the header of both
; the inner loop and the enclosing cycle.
; ---------------------------------------------------------------------------
function %zigzag(i32 sext) -> i32 sext {
block0(v0: i32):                                 ; n
    v1 = iconst.i32 0
    jump block1(v0, v0, v1)                      ; rounds, i, acc

block1(v2: i32, v3: i32, v4: i32):               ; loop A header
    v5 = icmp_imm sgt v3, 0
    brif v5, block2(v2, v3, v4), block3(v2, v4)

block2(v6: i32, v7: i32, v8: i32):               ; loop A latch
    v9 = iadd_imm v7, -1
    v10 = iadd_imm v8, 1
    jump block1(v6, v9, v10)

block3(v11: i32, v12: i32):                      ; loop B header
    v13 = icmp_imm sgt v11, 0
    brif v13, block4(v11, v12), block5(v12)

block4(v14: i32, v15: i32):                      ; loop B latch, re-enters loop A
    v16 = iadd_imm v14, -1
    v17 = iadd_imm v15, 100
    jump block1(v16, v16, v17)

block5(v18: i32):
    return v18
}

; run: %zigzag(0) == 0
; run: %zigzag(1) == 101
; run: %zigzag(2) == 203
; run: %zigzag(3) == 306
