test interpret
test run
target scry32

; i16 values flowing across blocks as block parameters, exercising the
; block-param handling (Echo insertion, JumpTrigger type unification) for the
; size_pow2 == 1 type.

function %maybe_add_one_i16(i16 uext) -> i16 uext {
block0(v0: i16):
    brif v0, block2(v0), block3(v0)

block2(v1: i16):
    v2 = iadd_imm v1, 1
    jump block3(v2)

block3(v3: i16):
    return v3
}

; run: %maybe_add_one_i16(0) == 0
; run: %maybe_add_one_i16(16) == 17
; run: %maybe_add_one_i16(65535) == 0
