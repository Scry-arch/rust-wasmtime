test interpret
test run
target scry32

; Loops that can be left from somewhere other than the header.
;

; ---------------------------------------------------------------------------
; Breaking out of two loops at once: the inner body jumps directly to the block
; that follows the outer loop, so the outer exit joins the outer header's false
; arm with an edge originating two nesting levels deeper.
; ---------------------------------------------------------------------------
function %double_break(i32 sext, i32 sext, i32 sext) -> i32 sext {
block0(v0: i32, v1: i32, v2: i32):                          ; n, m, target
    v3 = iconst.i32 0
    jump block1(v0, v1, v2, v3)                             ; i, m, target, acc

block1(v4: i32, v5: i32, v6: i32, v7: i32):                 ; outer header
    v8 = icmp_imm sgt v4, 0
    brif v8, block2(v4, v5, v6, v7), block6(v7)

block2(v9: i32, v10: i32, v11: i32, v12: i32):              ; outer body
    jump block3(v9, v10, v10, v11, v12)                     ; i, m, j, target, acc

block3(v13: i32, v14: i32, v15: i32, v16: i32, v17: i32):   ; inner header
    v18 = icmp_imm sgt v15, 0
    brif v18, block4(v13, v14, v15, v16, v17), block5(v13, v14, v16, v17)

block4(v19: i32, v20: i32, v21: i32, v22: i32, v23: i32):   ; inner body: break
    v24 = iadd_imm v23, 1                                   ; out of *both* loops
    v25 = icmp eq v24, v22
    v26 = iadd_imm v21, -1
    brif v25, block6(v24), block3(v19, v20, v26, v22, v24)

block5(v27: i32, v28: i32, v29: i32, v30: i32):             ; outer latch
    v31 = iadd_imm v27, -1
    jump block1(v31, v28, v29, v30)

block6(v32: i32):                                           ; exit, two preds at
    return v32                                              ; different depths
}

; run: %double_break(3, 4, 5) == 5
; run: %double_break(3, 4, 1) == 1
; run: %double_break(3, 4, 12) == 12
; run: %double_break(3, 4, 100) == 12
; run: %double_break(3, 4, 0) == 12
; run: %double_break(0, 4, 1) == 0
; run: %double_break(2, 2, 4) == 4
