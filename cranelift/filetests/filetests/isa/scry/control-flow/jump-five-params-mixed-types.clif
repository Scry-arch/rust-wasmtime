test interpret
test run
target scry32

; Five block arguments of mixed types (i32 and i16 interleaved) to
; excercise type resolution with having to split branch params across
; several split echoes.

function %mixed5(i32 sext, i16 sext, i32 sext, i16 sext) -> i32 sext {
block0(v0: i32, v1: i16, v2: i32, v3: i16):
    v4 = iadd v0, v2
    jump block1(v0, v1, v2, v3, v4)

block1(v5: i32, v6: i16, v7: i32, v8: i16, v9: i32):
    v10 = sextend.i32 v6
    v11 = sextend.i32 v8
    ; Horner: 16*v5 + 8*v10 + 4*v7 + 2*v11 + v9
    v12 = iadd v5, v5
    v13 = iadd v12, v10
    v14 = iadd v13, v13
    v15 = iadd v14, v7
    v16 = iadd v15, v15
    v17 = iadd v16, v11
    v18 = iadd v17, v17
    v19 = iadd v18, v9
    return v19
}

; r = 16*v0 + 8*v1 + 4*v2 + 2*v3 + (v0+v2) = 17*v0 + 8*v1 + 5*v2 + 2*v3
; run: %mixed5(0, 0, 0, 0) == 0
; run: %mixed5(1, 0, 0, 0) == 17
; run: %mixed5(0, 1, 0, 0) == 8
; run: %mixed5(0, 0, 1, 0) == 5
; run: %mixed5(0, 0, 0, 1) == 2
; run: %mixed5(1, 2, 3, 4) == 56
; run: %mixed5(-1, -2, -3, -4) == -56
; run: %mixed5(100, -30, 7, -2) == 1491
