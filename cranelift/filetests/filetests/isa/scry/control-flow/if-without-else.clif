test interpret
test run
target scry32

; Triangle CFGs: a conditional where only one arm has a body, so one
; predecessor of the join is the branching block itself. This is the smallest
; CFG where a join block's two predecessors sit at different depths, and it is
; the shape every `if` without an `else` lowers to.
;

; ---------------------------------------------------------------------------
; The body is on the *taken* arm.
;
;   block0 --> block1 --> block2
;      \___________________^
; ---------------------------------------------------------------------------
function %tri(i32 sext, i32 sext) -> i32 sext {
block0(v0: i32, v1: i32):
    brif v0, block1(v1), block2(v1)

block1(v2: i32):
    v5 = iconst.i32 1
    v3 = iadd v2, v5
    jump block2(v3)

block2(v4: i32):
    return v4
}

; run: %tri(1, 5) == 6
; run: %tri(0, 5) == 5
; run: %tri(1, -1) == 0
; run: %tri(0, 0) == 0

; ---------------------------------------------------------------------------
; The same triangle with the arms swapped, so the body is on the not-taken
; arm.
; ---------------------------------------------------------------------------
function %tri_else(i32 sext, i32 sext) -> i32 sext {
block0(v0: i32, v1: i32):
    brif v0, block2(v1), block1(v1)

block1(v2: i32):
    v5 = iconst.i32 1
    v3 = iadd v2, v5
    jump block2(v3)

block2(v4: i32):
    return v4
}

; run: %tri_else(1, 5) == 5
; run: %tri_else(0, 5) == 6
; run: %tri_else(1, 0) == 0
; run: %tri_else(0, -1) == 0

; ---------------------------------------------------------------------------
; Two triangles in sequence sharing no blocks, so the second one's branching
; block is also the first one's join.
; ---------------------------------------------------------------------------
function %tri_chain(i32 sext, i32 sext, i32 sext) -> i32 sext {
block0(v0: i32, v1: i32, v2: i32):
    brif v0, block1(v1, v2), block2(v1, v2)

block1(v3: i32, v4: i32):
    v11 = iconst.i32 1
    v5 = iadd v4, v11
    jump block2(v3, v5)

block2(v6: i32, v7: i32):
    brif v6, block3(v7), block4(v7)

block3(v8: i32):
    v12 = iconst.i32 10
    v9 = iadd v8, v12
    jump block4(v9)

block4(v10: i32):
    return v10
}

; run: %tri_chain(0, 0, 100) == 100
; run: %tri_chain(1, 0, 100) == 101
; run: %tri_chain(0, 1, 100) == 110
; run: %tri_chain(1, 1, 100) == 111
