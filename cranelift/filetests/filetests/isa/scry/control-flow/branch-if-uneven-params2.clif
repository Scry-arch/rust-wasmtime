test interpret
test run
target scry32

; Tests successors with different parameter counts
function %maybe_sum(i32 uext, i32 uext) -> i32 uext {
block0(v0: i32, v1:i32):
    brif v0, block3(v1), block2(v0, v1)

block2(v2: i32, v3: i32):
    v4 = iadd v2, v3
    jump block4(v4)

block3(v5: i32):
    v6 = iadd v5, v5
    jump block4(v6)

block4(v7: i32):
    return v7
}

; run: %maybe_sum(0,0) == 0
; run: %maybe_sum(0,4) == 4
; run: %maybe_sum(1,0) == 0
; run: %maybe_sum(25,100) == 200