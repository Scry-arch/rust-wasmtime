test interpret
test run
target scry32

; An unconditional `jump` back-edge that forwards one of the target block's
; own parameters unchanged (a loop-invariant carried value).

; Minimal trigger, cg_clif while-loop shape: header block1 is entered by
; unconditional jumps; the latch (block2) forwards v4 unchanged.
function %jump_forward(i32 uext, i32 uext) -> i32 uext {
block0(v0: i32, v1: i32):
    v2 = iconst.i32 0
    jump block1(v2, v1)

block1(v3: i32, v4: i32):
    v5 = icmp ult v3, v0
    brif v5, block2, block3

block2:
    v6 = iadd v3, v4
    jump block1(v6, v4)

block3:
    return v3
}
; run: %jump_forward(10, 3) == 12
; run: %jump_forward(0, 3) == 0
; run: %jump_forward(1, 1) == 1
; run: %jump_forward(7, 7) == 7
; run: %jump_forward(5, 10) == 10
; run: %jump_forward(100, 1) == 100
; run: %jump_forward(4294967295, 4294967295) == 4294967295

; The memset shape: index advances, accumulator changes, two invariants
; (v7, v8) carried unchanged.
function %two_invariants(i32 uext, i32 uext, i32 uext) -> i32 uext {
block0(v0: i32, v1: i32, v2: i32):
    v3 = iconst.i32 0
    v4 = iconst.i32 0
    jump block1(v3, v4, v1, v2)

block1(v5: i32, v6: i32, v7: i32, v8: i32):
    v9 = icmp ult v5, v0
    brif v9, block2, block3

block2:
    v10 = iadd v6, v7
    v11 = iadd v10, v8
    v12 = iconst.i32 1
    v13 = iadd v5, v12
    jump block1(v13, v11, v7, v8)

block3:
    return v6
}
; run: %two_invariants(4, 3, 5) == 32
; run: %two_invariants(0, 3, 5) == 0
; run: %two_invariants(1, 3, 5) == 8
; run: %two_invariants(3, 1, 2) == 9
; run: %two_invariants(10, 0, 0) == 0
; run: %two_invariants(5, 2, 3) == 25
; run: %two_invariants(2, 4294967295, 1) == 0

; The same invariant v4 forwarded over a conditional
; back-edge.
function %brif_forward(i32 uext, i32 uext) -> i32 uext {
block0(v0: i32, v1: i32):
    v2 = iconst.i32 0
    jump block1(v2, v1)

block1(v3: i32, v4: i32):
    v5 = iadd v3, v4
    v6 = icmp ult v5, v0
    brif v6, block1(v5, v4), block2

block2:
    return v3
}
; run: %brif_forward(10, 3) == 9
; run: %brif_forward(10, 10) == 0
; run: %brif_forward(1, 1) == 0
; run: %brif_forward(2, 1) == 1
; run: %brif_forward(100, 7) == 98
; run: %brif_forward(0, 5) == 0

; Unconditional latch jump, but every parameter is a
; fresh value. No self-forward.
function %no_forward(i32 uext, i32 uext) -> i32 uext {
block0(v0: i32, v1: i32):
    v2 = iconst.i32 0
    jump block1(v2, v1)

block1(v3: i32, v4: i32):
    v5 = icmp ult v3, v0
    brif v5, block2, block3

block2:
    v6 = iadd v3, v4
    v7 = iadd v4, v4
    jump block1(v6, v7)

block3:
    return v3
}
; run: %no_forward(100, 1) == 127
; run: %no_forward(0, 1) == 0
; run: %no_forward(1, 1) == 1
; run: %no_forward(5, 1) == 7
; run: %no_forward(10, 5) == 15
; run: %no_forward(3, 2) == 6
