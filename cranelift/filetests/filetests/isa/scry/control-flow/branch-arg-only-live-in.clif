test interpret
test run
target scry32

; Values whose ONLY use in a block is as a branch argument. No instruction
; mentions them, so they reach the block's `branch_params` without appearing
; in any instruction's use list.

; ---------------------------------------------------------------------------
; Direct path: v0 is used in block1 only as the brif's edge argument. block3
; has a single predecessor, so the argument stays on block1's own edge.
; ---------------------------------------------------------------------------
function %brif_arg_only(i32 sext, i32 sext) -> i32 sext {
block0(v0: i32, v1: i32):
    jump block1

block1:
    brif v1, block2, block3(v0)

block2:
    return v1

block3(v2: i32):
    return v2
}

; run: %brif_arg_only(7, 0) == 7
; run: %brif_arg_only(7, 3) == 3
; run: %brif_arg_only(-9, 0) == -9

; ---------------------------------------------------------------------------
; Promoted-edge path: block1 -> block3 is critical (block3 also hears from
; block2), so lowering splits it with an edge block whose ImmJump carries v0;
; edge-block promotion then hoists v0 into block1's branch parameters.
; ---------------------------------------------------------------------------
function %promoted_edge_arg(i32 sext, i32 sext) -> i32 sext {
block0(v0: i32, v1: i32):
    jump block1

block1:
    brif v1, block2, block3(v0)

block2:
    jump block3(v1)

block3(v2: i32):
    return v2
}

; run: %promoted_edge_arg(7, 0) == 7
; run: %promoted_edge_arg(7, 3) == 3
; run: %promoted_edge_arg(-9, 0) == -9

; ---------------------------------------------------------------------------
; The shape frontends actually emit: a loop-carried value updated only
; conditionally. The not-updated path (block2 -> block4) forwards the old
; flag as a bare branch argument. Counts i from 0 to n, setting the flag
; when i == 3 is seen.
; ---------------------------------------------------------------------------
function %cond_update_in_loop(i32 sext) -> i32 sext {
block0(v0: i32):
    v1 = iconst.i32 0
    v2 = iconst.i32 0
    jump block1(v1, v2)

block1(v3: i32, v4: i32):
    v5 = icmp slt v4, v0
    brif v5, block2, block5(v3)

block2:
    v6 = iconst.i32 3
    v7 = icmp eq v4, v6
    brif v7, block3, block4(v3)

block3:
    v8 = iconst.i32 1
    jump block4(v8)

block4(v9: i32):
    v10 = iconst.i32 1
    v11 = iadd v4, v10
    jump block1(v9, v11)

block5(v12: i32):
    return v12
}

; run: %cond_update_in_loop(0) == 0
; run: %cond_update_in_loop(3) == 0
; run: %cond_update_in_loop(4) == 1
; run: %cond_update_in_loop(10) == 1
