test interpret
test run
target scry32

; A `br_table` arm that performs an overflow-checked addition, i.e. the payload
; is used twice (by the `iadd` and by the `icmp` that detects the wrap-around),
; and branches to a cold block when the addition wraps. A sentinel is returned
; instead of trapping so the wrong path is observable: 999 = the default arm,
; 555 = the overflow branch.
;
; The essential ingredients, found by ablation:
;   - the two-arm `br_table` (a two-way `brif` entry passes),
;   - the arm ending in a `brif`,
;   - `cold` on that `brif`'s taken target (and only there: `cold` on the
;     default arm instead does not trigger it, and without any `cold` the
;     function passes).
; The `iadd` itself is not needed, but the checked add is kept as the
; realistic use.
function %match_add(i32 uext, i32 uext) -> i32 uext {
block0(v0: i32, v1: i32):
    br_table v0, block1, [block2, block3(v1)]

block1:
    v2 = iconst.i32 999
    return v2

block2:
    v3 = iconst.i32 7
    return v3

block3(v4: i32):
    v5 = iconst.i32 100
    v6 = iadd v4, v5
    v7 = icmp ult v6, v4
    brif v7, block4, block5

block4 cold:
    v8 = iconst.i32 555
    return v8

block5:
    return v6
}
; run: %match_add(1, 3) == 103
; run: %match_add(1, 0) == 100
; run: %match_add(0, 3) == 7
; run: %match_add(2, 3) == 999
; run: %match_add(1, -1) == 555
; run: %match_add(1, -100) == 555
; run: %match_add(1, -101) == 4294967295
