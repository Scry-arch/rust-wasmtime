    v4 = load.i32 v3
    brif v4, block3, block2
block3:
    v5 = stack_addr.i32 ss0
    v6 = load.i32 v5+4
    v20 = bnot v6
    v21 = bnot v20
    v22 = bnot v21
    v23 = bnot v22
    v24 = bnot v23
    v25 = bnot v24
    v26 = bnot v25
    v27 = bnot v26
    v28 = bnot v27
    v29 = bnot v28
    v30 = bnot v29
    v31 = bnot v30
    v32 = bnot v31
    v33 = bnot v32
    v34 = bnot v33
