;; Forward conditional branch over the body (and the merge block) to the
;; edge block that leads to the merge.
function %fwd_cond_short(i32 uext) -> i32 uext {
    ss0 = explicit_slot 4
block0(v0: i32):
    v1 = stack_addr.i32 ss0
    store v0, v1
    brif v0, block2, block1
block1:
    v2 = iconst.i32 7
    v20 = bnot v2
    v21 = bnot v20
    v22 = bnot v21
    v23 = bnot v22
    v24 = bnot v23
    v25 = bnot v24
    v26 = bnot v25
    v27 = bnot v26
    v28 = bnot v27
    v29 = bnot v28
    v30 = bnot v29
    v31 = bnot v30
    v32 = bnot v31
    v33 = bnot v32
    v34 = bnot v33
    v35 = bnot v34
    v36 = bnot v35
    v37 = bnot v36
    v38 = bnot v37
    v39 = bnot v38
    v40 = bnot v39
    v41 = bnot v40
    v42 = bnot v41
    v43 = bnot v42
    v44 = bnot v43
    v45 = bnot v44
    v46 = bnot v45
    v47 = bnot v46
    v48 = bnot v47
    v49 = bnot v48
    v50 = bnot v49
    v51 = bnot v50
    v52 = bnot v51
    v53 = bnot v52
    v54 = bnot v53
    v55 = bnot v54
    v56 = bnot v55
    v57 = bnot v56
    v58 = bnot v57
    v59 = bnot v58
    v60 = bnot v59
    v61 = bnot v60
    v62 = bnot v61
    v63 = bnot v62
    v64 = bnot v63
    v65 = bnot v64
    v66 = bnot v65
    v67 = bnot v66
    v68 = bnot v67
    v69 = bnot v68
    v70 = bnot v69
    v71 = bnot v70
    v72 = bnot v71
    v73 = bnot v72
    v3 = stack_addr.i32 ss0
    store v73, v3
    jump block2
block2:
    v4 = stack_addr.i32 ss0
    v5 = load.i32 v4
    v6 = iconst.i32 100
    v7 = iadd v5, v6
    return v7
}
; run: %fwd_cond_short(0) == 107
; run: %fwd_cond_short(5) == 105
; not: JumpOffset

