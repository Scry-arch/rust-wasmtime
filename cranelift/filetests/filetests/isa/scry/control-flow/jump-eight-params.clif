test interpret
test run
target scry32

; An unconditional jump passing eight block arguments, which requires at
; least 2 splitting echoes to reroute.
;
; Weighted sum with weights 128,64,32,16,8,4,2,1 by position detects any
; misrouting.

function %jump8(i32 sext, i32 sext, i32 sext, i32 sext) -> i32 sext {
block0(v0: i32, v1: i32, v2: i32, v3: i32):
    v4 = iadd v0, v1
    v5 = iadd v1, v2
    v6 = iadd v2, v3
    v7 = iadd v3, v0
    jump block1(v0, v1, v2, v3, v4, v5, v6, v7)

block1(v8: i32, v9: i32, v10: i32, v11: i32, v12: i32, v13: i32, v14: i32, v15: i32):
    ; Horner: 128*v8 + 64*v9 + 32*v10 + 16*v11 + 8*v12 + 4*v13 + 2*v14 + v15
    v16 = iadd v8, v8
    v17 = iadd v16, v9
    v18 = iadd v17, v17
    v19 = iadd v18, v10
    v20 = iadd v19, v19
    v21 = iadd v20, v11
    v22 = iadd v21, v21
    v23 = iadd v22, v12
    v24 = iadd v23, v23
    v25 = iadd v24, v13
    v26 = iadd v25, v25
    v27 = iadd v26, v14
    v28 = iadd v27, v27
    v29 = iadd v28, v15
    return v29
}

; r = 128*v0 + 64*v1 + 32*v2 + 16*v3
;   + 8*(v0+v1) + 4*(v1+v2) + 2*(v2+v3) + (v3+v0)
;   = 137*v0 + 76*v1 + 38*v2 + 19*v3
; run: %jump8(0, 0, 0, 0) == 0
; run: %jump8(1, 0, 0, 0) == 137
; run: %jump8(0, 1, 0, 0) == 76
; run: %jump8(0, 0, 1, 0) == 38
; run: %jump8(0, 0, 0, 1) == 19
; run: %jump8(1, 1, 1, 1) == 270
; run: %jump8(1, 2, 3, 4) == 479
; run: %jump8(-2, 1, 0, 3) == -141
