test interpret
test run
target scry32

; A diamond whose arms receive different branch arguments and compute a
; different offset on them, so the result reveals both which arm was taken and
; which value it received.

function %select_add(i32 uext, i32 uext) -> i32 uext {
block0(v0: i32, v1: i32):
    brif v0, block1(v0), block2(v1)

block1(v2: i32):
    v3 = iadd_imm v2, 100
    jump block3(v3)

block2(v4: i32):
    v5 = iadd_imm v4, 200
    jump block3(v5)

block3(v6: i32):
    return v6
}

; run: %select_add(0, 7) == 207
; run: %select_add(3, 7) == 103
; run: %select_add(0, 0) == 200
; run: %select_add(-1, 5) == 99
