;   Const(ty: Known(Uint(2)), rd:, v(205), imm: 0, )
;   Reorder(rd1:, v(219), rd2:, v(220), rs1:, v(218), rs2:, v(205), out: 2, )
;   UnaryAlu(op: LogNeg, rd:, v(221), rs:, v(217), )
;   JumpIssue(link:, v(204), kind: Branch(dir: true, cond: v(221)), dst: MachLabel(2), trig: 0, )
;   JumpTrigger(link:, v(204), args:, v(220), v(219), )
