test compile precise-output
target scry32

; Diverging control flow: CFGs with no path from some (or any) block to an
; exit. cg_clif emits these for `fn ... -> ! { loop {} }` bodies. In
; scry-core: panicking::panic_in_cleanup and panicking::eh_personality.
; Every block carries real work so blocks cannot be trivially collapsed, and
; the loops keep a live accumulator flowing across the back-edge.

; The shape rustc emits for panic_in_cleanup: a jump chain ending in a
; self-loop, no return instruction anywhere.
function %spin_chain() {
block0:
    v0 = iconst.i32 0
    jump block1(v0)

block1(v1: i32):
    v2 = iconst.i32 1
    v3 = iadd v1, v2
    jump block2(v3)

block2(v4: i32):
    v5 = iconst.i32 2
    v6 = iadd v4, v5
    jump block2(v6)
}

; VCode:
; block0:
;   Const(ty: Known(Uint(2)), rd:, v(206), imm: 0, )
;   EchoLong(rds:, v(209), rss:, v(206), out: 1, )
;   JumpIssue(link:, v(205), kind: Jump, dst: MachLabel(1), trig: 0, )
;   JumpTrigger(link:, v(205), args:, v(209), )
; block1:
;   EchoLong(rds:, v(207), rss:, v(193), out: 1, )
;   Const(ty: Known(Uint(2)), rd:, v(204), imm: 1, )
;   Alu2(var: Add, var_out LowOnly, rds:, v(203), rss:, v(207), v(204), outs: [1], )
;   JumpIssue(link:, v(202), kind: Jump, dst: MachLabel(2), trig: 0, )
;   JumpTrigger(link:, v(202), args:, v(203), )
; block2:
;   EchoLong(rds:, v(208), rss:, v(196), out: 1, )
;   Const(ty: Known(Uint(2)), rd:, v(201), imm: 2, )
;   Alu2(var: Add, var_out LowOnly, rds:, v(200), rss:, v(208), v(201), outs: [1], )
;   JumpIssue(link:, v(199), kind: Jump, dst: MachLabel(2), trig: 0, )
;   JumpTrigger(link:, v(199), args:, v(200), )
;
; Disassembled:
; block0: ; offset 0x0
; const u32, 0
; echo =>1
; nop 
; block1: ; offset 0x6
; echo =>1
; const u32, 1
; add Low =>1
; nop 
; block2: ; offset 0xe
; echo =>1
; const u32, 2
; add Low =>1
; jmp -3, 0

;; A multi-block cycle with no exit.
function %spin_cycle() {
block0:
    v0 = iconst.i32 7
    jump block1(v0)

block1(v1: i32):
    v2 = iconst.i32 1
    v3 = iadd v1, v2
    jump block2(v3)

block2(v4: i32):
    v5 = iconst.i32 3
    v6 = iadd v4, v5
    jump block1(v6)
}

; VCode:
; block0:
;   Const(ty: Known(Uint(2)), rd:, v(206), imm: 7, )
;   EchoLong(rds:, v(209), rss:, v(206), out: 1, )
;   JumpIssue(link:, v(205), kind: Jump, dst: MachLabel(1), trig: 0, )
;   JumpTrigger(link:, v(205), args:, v(209), )
; block1:
;   EchoLong(rds:, v(207), rss:, v(193), out: 1, )
;   Const(ty: Known(Uint(2)), rd:, v(204), imm: 1, )
;   Alu2(var: Add, var_out LowOnly, rds:, v(203), rss:, v(207), v(204), outs: [1], )
;   JumpIssue(link:, v(202), kind: Jump, dst: MachLabel(2), trig: 0, )
;   JumpTrigger(link:, v(202), args:, v(203), )
; block2:
;   EchoLong(rds:, v(208), rss:, v(196), out: 1, )
;   Const(ty: Known(Uint(2)), rd:, v(201), imm: 3, )
;   Alu2(var: Add, var_out LowOnly, rds:, v(200), rss:, v(208), v(201), outs: [1], )
;   JumpIssue(link:, v(199), kind: Jump, dst: MachLabel(1), trig: 0, )
;   JumpTrigger(link:, v(199), args:, v(200), )
;
; Disassembled:
; block0: ; offset 0x0
; const u32, 7
; echo =>1
; nop 
; block1: ; offset 0x6
; echo =>1
; const u32, 1
; add Low =>1
; nop 
; block2: ; offset 0xe
; echo =>1
; const u32, 3
; add Low =>1
; jmp -7, 0

;; Conditionally diverging: one path loops forever, the other returns. block2
;; uses v0 directly — a cross-block use of a dominating definition.
function %spin_cond(i32) -> i32 {
block0(v0: i32):
    v1 = iconst.i32 0
    brif v0, block1(v1), block2

block1(v2: i32):
    v3 = iconst.i32 1
    v4 = iadd v2, v3
    jump block1(v4)

block2:
    v5 = iconst.i32 5
    v6 = iadd v0, v5
    return v6
}

