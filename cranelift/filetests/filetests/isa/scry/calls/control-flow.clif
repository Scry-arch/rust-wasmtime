test interpret
test run
target scry32

; Calls in branches and loops.

function %add_one(i32 uext) -> i32 uext {
block0(v0: i32):
    v1 = iconst.i32 1
    v2 = iadd v0, v1
    return v2
}

function %add_two(i32 uext) -> i32 uext {
block0(v0: i32):
    v1 = iconst.i32 2
    v2 = iadd v0, v1
    return v2
}

; A call to a different callee in each arm of a diamond.
function %call_in_arms(i32 uext, i32 uext) -> i32 uext {
    fn0 = %add_one(i32 uext) -> i32 uext
    fn1 = %add_two(i32 uext) -> i32 uext
block0(v0: i32, v1: i32):
    brif v0, block1(v1), block2(v1)

block1(v2: i32):
    v3 = call fn0(v2)
    jump block3(v3)

block2(v4: i32):
    v5 = call fn1(v4)
    jump block3(v5)

block3(v6: i32):
    return v6
}
; run: %call_in_arms(1, 10) == 11
; run: %call_in_arms(0, 10) == 12

; Only one path through the function calls.
function %conditional_call(i32 uext, i32 uext) -> i32 uext {
    fn0 = %add_one(i32 uext) -> i32 uext
block0(v0: i32, v1: i32):
    brif v0, block1(v1), block2(v1)

block1(v2: i32):
    v3 = call fn0(v2)
    jump block3(v3)

block2(v4: i32):
    v5 = iconst.i32 0
    v6 = iadd v4, v5
    jump block3(v6)

block3(v7: i32):
    return v7
}
; run: %conditional_call(1, 10) == 11
; run: %conditional_call(0, 10) == 10

; A call in a loop body: sums add_one(i) for i = n..1, so the result is
; n(n+1)/2 + n. Only valid for n >= 1.
function %call_in_loop(i32 uext) -> i32 uext {
    fn0 = %add_one(i32 uext) -> i32 uext
block0(v0: i32):
    v1 = iconst.i32 0
    jump block1(v0, v1)

block1(v2: i32, v3: i32):
    v4 = call fn0(v2)
    v5 = iadd v3, v4
    v6 = iconst.i32 1
    v7 = isub v2, v6
    brif v7, block1(v7, v5), block2(v5)

block2(v8: i32):
    return v8
}
; run: %call_in_loop(1) == 2
; run: %call_in_loop(3) == 9
; run: %call_in_loop(5) == 20
