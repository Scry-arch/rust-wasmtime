test interpret
test run
target scry32

; func_addr and call_indirect within the module. (call_indirect with a
; pointer arriving as a function argument is already exercised by every
; run-test trampoline; here the pointer is materialized with func_addr.)

function %add_one(i32 uext) -> i32 uext {
block0(v0: i32):
    v1 = iconst.i32 1
    v2 = iadd v0, v1
    return v2
}

function %add_two(i32 uext) -> i32 uext {
block0(v0: i32):
    v1 = iconst.i32 2
    v2 = iadd v0, v1
    return v2
}

function %call_ind(i32 uext) -> i32 uext {
    fn0 = %add_one(i32 uext) -> i32 uext
block0(v0: i32):
    v1 = func_addr.i32 fn0
    v2 = call_indirect sig0, v1(v0)
    return v2
}
; run: %call_ind(0) == 1
; run: %call_ind(41) == 42

; Two sequential indirect calls through different pointers.
function %call_ind_twice(i32 uext) -> i32 uext {
    fn0 = %add_one(i32 uext) -> i32 uext
    fn1 = %add_two(i32 uext) -> i32 uext
block0(v0: i32):
    v1 = func_addr.i32 fn0
    v2 = call_indirect sig0, v1(v0)
    v3 = func_addr.i32 fn1
    v4 = call_indirect sig0, v3(v2)
    return v4
}
; run: %call_ind_twice(0) == 3
; run: %call_ind_twice(39) == 42

; A function pointer selected in a branch and called at the merge point.
function %select_callee(i32 uext, i32 uext) -> i32 uext {
    fn0 = %add_one(i32 uext) -> i32 uext
    fn1 = %add_two(i32 uext) -> i32 uext
block0(v0: i32, v1: i32):
    brif v0, block1(v1), block2(v1)

block1(v2: i32):
    v3 = func_addr.i32 fn0
    jump block3(v3, v2)

block2(v4: i32):
    v5 = func_addr.i32 fn1
    jump block3(v5, v4)

block3(v6: i32, v7: i32):
    v8 = call_indirect sig0, v6(v7)
    return v8
}
; run: %select_callee(1, 10) == 11
; run: %select_callee(0, 10) == 12
