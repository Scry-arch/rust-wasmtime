test interpret
test run
target scry32

; A self-recursive function with five parameters: every level both receives
; a stack argument and passes one, so the frame handoff (shared -> private)
; must work repeatedly down and back up the call chain. The three middle
; values are ROTATED at each level (like loop-five-params), making the
; positional routing at every depth observable, and each non-base level adds
; 1 after its recursive call returns.
;
; rec5(n, a, b, c, acc) = 2 * (acc + sum of first n of cyclic a,b,c,...)
;                         + (n - 1)

function %rec5(i32 sext, i32 sext, i32 sext, i32 sext, i32 sext) -> i32 sext {
    fn0 = %rec5(i32 sext, i32 sext, i32 sext, i32 sext, i32 sext) -> i32 sext
block0(v0: i32, v1: i32, v2: i32, v3: i32, v4: i32):
    v5 = iadd v4, v1
    v6 = iconst.i32 -1
    v7 = iadd v0, v6
    brif v7, block1(v7, v2, v3, v1, v5), block2(v5)

block1(v12: i32, v13: i32, v14: i32, v15: i32, v16: i32):
    v8 = call fn0(v12, v13, v14, v15, v16)
    v9 = iconst.i32 1
    v10 = iadd v8, v9
    return v10

block2(v17: i32):
    v11 = iadd v17, v17
    return v11
}

; run: %rec5(1, 10, 20, 30, 0) == 20
; run: %rec5(2, 10, 20, 30, 0) == 61
; run: %rec5(3, 10, 20, 30, 0) == 122
; run: %rec5(4, 10, 20, 30, 0) == 143
; run: %rec5(5, 10, 20, 30, 0) == 184
; run: %rec5(7, 1, 2, 3, 0) == 32
; run: %rec5(1, -5, 0, 0, 100) == 190
