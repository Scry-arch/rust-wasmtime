test interpret
test run
target scry32

; Stack arguments of mixed types. Per the ABI, each stack argument is placed
; at the next offset aligned to its scale, directly after the previous one.

; Stack args: v4 (i32, offset 0..4) then v5 (i16, offset 4..6) - no padding.
function %callee6(i32 sext, i16 sext, i32 sext, i16 sext, i32 sext, i16 sext) -> i32 sext {
block0(v0: i32, v1: i16, v2: i32, v3: i16, v4: i32, v5: i16):
    v6 = sextend.i32 v1
    v7 = sextend.i32 v3
    v8 = sextend.i32 v5
    ; Horner: 32*v0 + 16*v1 + 8*v2 + 4*v3 + 2*v4 + v5
    v9 = iadd v0, v0
    v10 = iadd v9, v6
    v11 = iadd v10, v10
    v12 = iadd v11, v2
    v13 = iadd v12, v12
    v14 = iadd v13, v7
    v15 = iadd v14, v14
    v16 = iadd v15, v4
    v17 = iadd v16, v16
    v18 = iadd v17, v8
    return v18
}

; run: %callee6(0, 0, 0, 0, 0, 0) == 0
; run: %callee6(1, 0, 0, 0, 0, 0) == 32
; run: %callee6(0, 1, 0, 0, 0, 0) == 16
; run: %callee6(0, 0, 1, 0, 0, 0) == 8
; run: %callee6(0, 0, 0, 1, 0, 0) == 4
; run: %callee6(0, 0, 0, 0, 1, 0) == 2
; run: %callee6(0, 0, 0, 0, 0, 1) == 1
; run: %callee6(1, 2, 3, 4, 5, 6) == 120
; run: %callee6(-1, -2, -3, -4, -5, -6) == -120

; Stack args: v3 (i16, offset 0..2) then v5 (i32, aligned up to offset
; 4..8) - the i32 must skip the 2 padding bytes after the i16.
function %callee6b(i32 sext, i32 sext, i32 sext, i16 sext, i16 sext, i32 sext) -> i32 sext {
block0(v0: i32, v1: i32, v2: i32, v3: i16, v4: i16, v5: i32):
    v6 = sextend.i32 v3
    v7 = sextend.i32 v4
    ; Horner: 32*v0 + 16*v1 + 8*v2 + 4*v3 + 2*v4 + v5
    v8 = iadd v0, v0
    v9 = iadd v8, v1
    v10 = iadd v9, v9
    v11 = iadd v10, v2
    v12 = iadd v11, v11
    v13 = iadd v12, v6
    v14 = iadd v13, v13
    v15 = iadd v14, v7
    v16 = iadd v15, v15
    v17 = iadd v16, v5
    return v17
}

; run: %callee6b(0, 0, 0, 0, 0, 0) == 0
; run: %callee6b(1, 0, 0, 0, 0, 0) == 32
; run: %callee6b(0, 1, 0, 0, 0, 0) == 16
; run: %callee6b(0, 0, 1, 0, 0, 0) == 8
; run: %callee6b(0, 0, 0, 1, 0, 0) == 4
; run: %callee6b(0, 0, 0, 0, 1, 0) == 2
; run: %callee6b(0, 0, 0, 0, 0, 1) == 1
; run: %callee6b(1, 2, 3, 4, 5, 6) == 120
; run: %callee6b(-6, -5, -4, -3, -2, -1) == -321

function %caller6b(i32 sext, i32 sext, i16 sext, i16 sext) -> i32 sext {
    fn0 = %callee6b(i32 sext, i32 sext, i32 sext, i16 sext, i16 sext, i32 sext) -> i32 sext
block0(v0: i32, v1: i32, v2: i16, v3: i16):
    v4 = iadd v0, v1
    v5 = isub v0, v1
    v6 = call fn0(v0, v1, v4, v2, v3, v5)
    return v6
}

; r = 32*v0 + 16*v1 + 8*(v0+v1) + 4*v2 + 2*v3 + (v0-v1)
;   = 41*v0 + 23*v1 + 4*v2 + 2*v3
; run: %caller6b(0, 0, 0, 0) == 0
; run: %caller6b(1, 0, 0, 0) == 41
; run: %caller6b(0, 1, 0, 0) == 23
; run: %caller6b(0, 0, 1, 0) == 4
; run: %caller6b(0, 0, 0, 1) == 2
; run: %caller6b(1, 2, 3, 4) == 107
; run: %caller6b(-3, 2, 5, -7) == -71
