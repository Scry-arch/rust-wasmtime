test interpret
test run
target scry32

; Function calls passing five arguments. All call-trigger operands are
; delivered to the callee's first instruction, whose ready queue holds at
; most four, and no reference can reach past a call boundary - so per the
; ABI the fifth argument is passed on the stack (caller's shared frame,
; which becomes the callee's private frame, at offset 0).
;
; The callee computes a weighted sum (weights 16,8,4,2,1 by position), so a
; dropped, duplicated, permuted, or misplaced argument changes the result;
; the unit-vector run cases identify which position broke. Direct runs also
; exercise the trampoline's five-argument call.

function %callee5(i32 sext, i32 sext, i32 sext, i32 sext, i32 sext) -> i32 sext {
block0(v0: i32, v1: i32, v2: i32, v3: i32, v4: i32):
    ; Horner: 16*v0 + 8*v1 + 4*v2 + 2*v3 + v4
    v5 = iadd v0, v0
    v6 = iadd v5, v1
    v7 = iadd v6, v6
    v8 = iadd v7, v2
    v9 = iadd v8, v8
    v10 = iadd v9, v3
    v11 = iadd v10, v10
    v12 = iadd v11, v4
    return v12
}

; run: %callee5(0, 0, 0, 0, 0) == 0
; run: %callee5(1, 0, 0, 0, 0) == 16
; run: %callee5(0, 1, 0, 0, 0) == 8
; run: %callee5(0, 0, 1, 0, 0) == 4
; run: %callee5(0, 0, 0, 1, 0) == 2
; run: %callee5(0, 0, 0, 0, 1) == 1
; run: %callee5(1, 2, 3, 4, 5) == 57

; A value (v3) stays live across the five-argument call; isub is
; non-commutative so its routing is observable.
function %caller_live(i32 sext, i32 sext, i32 sext, i32 sext) -> i32 sext {
    fn0 = %callee5(i32 sext, i32 sext, i32 sext, i32 sext, i32 sext) -> i32 sext
block0(v0: i32, v1: i32, v2: i32, v3: i32):
    v4 = iadd v0, v1
    v5 = call fn0(v0, v1, v2, v3, v4)
    v6 = isub v5, v3
    return v6
}

; r = 16*v0 + 8*v1 + 4*v2 + 2*v3 + (v0+v1) - v3 = 17*v0 + 9*v1 + 4*v2 + v3
; run: %caller_live(0, 0, 0, 0) == 0
; run: %caller_live(1, 0, 0, 0) == 17
; run: %caller_live(0, 1, 0, 0) == 9
; run: %caller_live(0, 0, 1, 0) == 4
; run: %caller_live(0, 0, 0, 1) == 1
; run: %caller_live(1, 2, 3, 4) == 51
; run: %caller_live(5, -2, 7, 3) == 98

; The caller has its own stack slot in use around the five-argument call,
; so the private frame and the shared stack-argument area must coexist.
function %caller_frame(i32 sext, i32 sext, i32 sext, i32 sext) -> i32 sext {
    ss0 = explicit_slot 4
    fn0 = %callee5(i32 sext, i32 sext, i32 sext, i32 sext, i32 sext) -> i32 sext
block0(v0: i32, v1: i32, v2: i32, v3: i32):
    v8 = stack_addr.i32 ss0
    store notrap v0, v8
    v4 = iadd v2, v3
    v5 = call fn0(v1, v2, v3, v4, v4)
    v9 = stack_addr.i32 ss0
    v6 = load.i32 notrap v9
    v7 = isub v5, v6
    return v7
}

; r = 16*v1 + 8*v2 + 4*v3 + 2*(v2+v3) + (v2+v3) - v0
;   = -v0 + 16*v1 + 11*v2 + 7*v3
; run: %caller_frame(0, 0, 0, 0) == 0
; run: %caller_frame(1, 0, 0, 0) == -1
; run: %caller_frame(0, 1, 0, 0) == 16
; run: %caller_frame(0, 0, 1, 0) == 11
; run: %caller_frame(0, 0, 0, 1) == 7
; run: %caller_frame(1, 2, 3, 4) == 92
