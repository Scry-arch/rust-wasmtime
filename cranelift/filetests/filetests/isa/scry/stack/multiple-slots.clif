test interpret
test run
target scry32

; Distinct slots must be allocated to distinct memory.
function %two_slots(i32 uext, i32 uext) -> i32 uext {
    ss0 = explicit_slot 4
    ss1 = explicit_slot 4
block0(v0: i32, v1: i32):
    v2 = stack_addr.i32 ss0
    store notrap v0, v2
    v3 = stack_addr.i32 ss1
    store notrap v1, v3
    v4 = stack_addr.i32 ss0
    v5 = load.i32 notrap v4
    v6 = stack_addr.i32 ss1
    v7 = load.i32 notrap v6
    v8 = isub v5, v7
    return v8
}
; run: %two_slots(0, 0) == 0
; run: %two_slots(100, 1) == 99
; run: %two_slots(1, 100) == -99

; Use order opposite of declaration order.
function %slots_used_reversed(i32 uext, i32 uext) -> i32 uext {
    ss0 = explicit_slot 4
    ss1 = explicit_slot 4
block0(v0: i32, v1: i32):
    v2 = stack_addr.i32 ss1
    store notrap v0, v2
    v3 = stack_addr.i32 ss0
    store notrap v1, v3
    v4 = stack_addr.i32 ss1
    v5 = load.i32 notrap v4
    v6 = stack_addr.i32 ss0
    v7 = load.i32 notrap v6
    v8 = isub v5, v7
    return v8
}
; run: %slots_used_reversed(100, 1) == 99
; run: %slots_used_reversed(1, 100) == -99

; Slots of different sizes holding different types.
function %three_slots_mixed(i32 uext, i32 uext, i32 uext) -> i32 uext {
    ss0 = explicit_slot 4
    ss1 = explicit_slot 2
    ss2 = explicit_slot 1
block0(v0: i32, v1: i32, v2: i32):
    v3 = ireduce.i16 v1
    v4 = ireduce.i8 v2
    v5 = stack_addr.i32 ss0
    store notrap v0, v5
    v6 = stack_addr.i32 ss1
    store notrap v3, v6
    v7 = stack_addr.i32 ss2
    store notrap v4, v7
    v8 = stack_addr.i32 ss0
    v9 = load.i32 notrap v8
    v10 = stack_addr.i32 ss1
    v11 = load.i16 notrap v10
    v12 = stack_addr.i32 ss2
    v13 = load.i8 notrap v12
    v14 = uextend.i32 v11
    v15 = uextend.i32 v13
    v16 = iadd v9, v14
    v17 = iadd v16, v15
    return v17
}
; run: %three_slots_mixed(1, 2, 3) == 6
; run: %three_slots_mixed(100, 65535, 255) == 65890
; run: %three_slots_mixed(0, 0, 0) == 0
