test interpret
test run
target scry32

; Two i32 values at different offsets in the same slot must not clobber
; each other. isub is order-sensitive, so this also catches swapped values.
function %two_offsets(i32 uext, i32 uext) -> i32 uext {
    ss0 = explicit_slot 8
block0(v0: i32, v1: i32):
    v2 = stack_addr.i32 ss0
    store notrap v0, v2
    v3 = stack_addr.i32 ss0+4
    store notrap v1, v3
    v4 = stack_addr.i32 ss0
    v5 = load.i32 notrap v4
    v6 = stack_addr.i32 ss0+4
    v7 = load.i32 notrap v6
    v8 = isub v5, v7
    return v8
}
; run: %two_offsets(0, 0) == 0
; run: %two_offsets(100, 1) == 99
; run: %two_offsets(1, 100) == -99
; run: %two_offsets(4294967295, 1) == 4294967294

; Same, but the higher offset is written first.
function %two_offsets_reversed(i32 uext, i32 uext) -> i32 uext {
    ss0 = explicit_slot 8
block0(v0: i32, v1: i32):
    v2 = stack_addr.i32 ss0+4
    store notrap v1, v2
    v3 = stack_addr.i32 ss0
    store notrap v0, v3
    v4 = stack_addr.i32 ss0+4
    v5 = load.i32 notrap v4
    v6 = stack_addr.i32 ss0
    v7 = load.i32 notrap v6
    v8 = isub v5, v7
    return v8
}
; run: %two_offsets_reversed(1, 100) == 99
; run: %two_offsets_reversed(100, 1) == -99

; A second store to the same offset overwrites the first.
function %overwrite(i32 uext, i32 uext) -> i32 uext {
    ss0 = explicit_slot 4
block0(v0: i32, v1: i32):
    v2 = stack_addr.i32 ss0
    store notrap v0, v2
    v3 = stack_addr.i32 ss0
    store notrap v1, v3
    v4 = stack_addr.i32 ss0
    v5 = load.i32 notrap v4
    return v5
}
; run: %overwrite(11, 22) == 22
; run: %overwrite(22, 11) == 11

; Adjacent byte-sized values must not clobber each other.
function %adjacent_bytes(i8 uext, i8 uext) -> i8 uext {
    ss0 = explicit_slot 4
block0(v0: i8, v1: i8):
    v2 = stack_addr.i32 ss0+1
    store notrap v0, v2
    v3 = stack_addr.i32 ss0+2
    store notrap v1, v3
    v4 = stack_addr.i32 ss0+1
    v5 = load.i8 notrap v4
    v6 = stack_addr.i32 ss0+2
    v7 = load.i8 notrap v6
    v8 = isub v5, v7
    return v8
}
; run: %adjacent_bytes(10, 3) == 7
; run: %adjacent_bytes(3, 10) == -7

; Adjacent i16 values at their natural alignment.
function %adjacent_i16(i16 sext, i16 sext) -> i16 sext {
    ss0 = explicit_slot 8
block0(v0: i16, v1: i16):
    v2 = stack_addr.i32 ss0+2
    store notrap v0, v2
    v3 = stack_addr.i32 ss0+4
    store notrap v1, v3
    v4 = stack_addr.i32 ss0+2
    v5 = load.i16 notrap v4
    v6 = stack_addr.i32 ss0+4
    v7 = load.i16 notrap v6
    v8 = isub v5, v7
    return v8
}
; run: %adjacent_i16(-5, 10) == -15
; run: %adjacent_i16(100, -100) == 200
