test interpret
test run
target scry32

; Basic store/load roundtrips through a single stack slot.
; CLIF has no stack_load/stack_store; all access is stack_addr + load/store.

function %roundtrip_u32(i32 uext) -> i32 uext {
    ss0 = explicit_slot 4
block0(v0: i32):
    v1 = stack_addr.i32 ss0
    store notrap v0, v1
    v2 = stack_addr.i32 ss0
    v3 = load.i32 notrap v2
    return v3
}
; run: %roundtrip_u32(0) == 0
; run: %roundtrip_u32(42) == 42
; run: %roundtrip_u32(4294967295) == 4294967295

function %roundtrip_i32(i32 sext) -> i32 sext {
    ss0 = explicit_slot 4
block0(v0: i32):
    v1 = stack_addr.i32 ss0
    store notrap v0, v1
    v2 = stack_addr.i32 ss0
    v3 = load.i32 notrap v2
    return v3
}
; run: %roundtrip_i32(1) == 1
; run: %roundtrip_i32(-1) == -1
; run: %roundtrip_i32(-2147483648) == -2147483648

function %roundtrip_i16(i16 sext) -> i16 sext {
    ss0 = explicit_slot 2
block0(v0: i16):
    v1 = stack_addr.i32 ss0
    store notrap v0, v1
    v2 = stack_addr.i32 ss0
    v3 = load.i16 notrap v2
    return v3
}
; run: %roundtrip_i16(0) == 0
; run: %roundtrip_i16(-100) == -100
; run: %roundtrip_i16(32767) == 32767

function %roundtrip_u8(i8 uext) -> i8 uext {
    ss0 = explicit_slot 1
block0(v0: i8):
    v1 = stack_addr.i32 ss0
    store notrap v0, v1
    v2 = stack_addr.i32 ss0
    v3 = load.i8 notrap v2
    return v3
}
; run: %roundtrip_u8(0) == 0
; run: %roundtrip_u8(101) == 101
; run: %roundtrip_u8(-1) == -1

; The same address value is used by both the store and the load.
function %shared_addr(i32 uext) -> i32 uext {
    ss0 = explicit_slot 4
block0(v0: i32):
    v1 = stack_addr.i32 ss0
    store notrap v0, v1
    v2 = load.i32 notrap v1
    return v2
}
; run: %shared_addr(0) == 0
; run: %shared_addr(77) == 77

; The loaded value must flow through normal dataflow afterwards.
function %load_feeds_add(i32 uext, i32 uext) -> i32 uext {
    ss0 = explicit_slot 4
block0(v0: i32, v1: i32):
    v2 = stack_addr.i32 ss0
    store notrap v0, v2
    v3 = stack_addr.i32 ss0
    v4 = load.i32 notrap v3
    v5 = iadd v4, v1
    return v5
}
; run: %load_feeds_add(1, 2) == 3
; run: %load_feeds_add(100, 27) == 127

; Store a constant rather than an argument.
function %store_const(i32 uext) -> i32 uext {
    ss0 = explicit_slot 4
block0(v0: i32):
    v1 = iconst.i32 77
    v2 = stack_addr.i32 ss0
    store notrap v1, v2
    v3 = stack_addr.i32 ss0
    v4 = load.i32 notrap v3
    v5 = iadd v4, v0
    return v5
}
; run: %store_const(0) == 77
; run: %store_const(23) == 100
