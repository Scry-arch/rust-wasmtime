test interpret
test run
target scry32

; sadd_overflow: the first two-output ALU instruction. The first result is
; the wrapping sum, the second an i8 flag that is 1 iff signed overflow
; occurred.

function %saddof_i32(i32 sext, i32 sext) -> i32 sext, i8 uext {
block0(v0: i32, v1: i32):
    v2, v3 = sadd_overflow v0, v1
    return v2, v3
}
; run: %saddof_i32(0, 0) == [0, 0]
; run: %saddof_i32(1, 2) == [3, 0]
; run: %saddof_i32(-1, 1) == [0, 0]
; run: %saddof_i32(-5, -10) == [-15, 0]
; run: %saddof_i32(2147483647, 1) == [-2147483648, 1]
; run: %saddof_i32(-2147483648, -1) == [2147483647, 1]
; run: %saddof_i32(2147483647, -2147483648) == [-1, 0]
; run: %saddof_i32(1073741824, 1073741824) == [-2147483648, 1]

; Only the value result is used; the flag must be cleanly discarded.
function %saddof_val(i32 sext, i32 sext) -> i32 sext {
block0(v0: i32, v1: i32):
    v2, v3 = sadd_overflow v0, v1
    return v2
}
; run: %saddof_val(1, 2) == 3
; run: %saddof_val(2147483647, 1) == -2147483648
; run: %saddof_val(-7, 3) == -4

; Only the flag is used; the value must be cleanly discarded.
function %saddof_flag(i32 sext, i32 sext) -> i8 uext {
block0(v0: i32, v1: i32):
    v2, v3 = sadd_overflow v0, v1
    return v3
}
; run: %saddof_flag(1, 2) == 0
; run: %saddof_flag(2147483647, 1) == 1
; run: %saddof_flag(-2147483648, -1) == 1
; run: %saddof_flag(-1, 1) == 0

; Both outputs are consumed by different follow-up instructions. (The flag
; is widened with sextend so the arithmetic stays uniformly signed: the
; backend's type analysis does not support mixed-signedness arithmetic, and
; a 0/1 flag widens the same either way.)
function %saddof_combine(i32 sext, i32 sext) -> i32 sext {
block0(v0: i32, v1: i32):
    v2, v3 = sadd_overflow v0, v1
    v4 = sextend.i32 v3
    v5 = iadd v2, v4
    return v5
}
; run: %saddof_combine(1, 2) == 3
; run: %saddof_combine(2147483647, 1) == -2147483647
; run: %saddof_combine(-2147483648, -1) == -2147483648

; Like %saddof_combine, but the outputs are consumed in the opposite order:
; the value first, the flag later. Computes (wrap(a+b) - 1) - flag.
function %saddof_combine_rev(i32 sext, i32 sext) -> i32 sext {
block0(v0: i32, v1: i32):
    v2, v3 = sadd_overflow v0, v1
    v4 = iconst.i32 1
    v5 = isub v2, v4
    v6 = sextend.i32 v3
    v7 = isub v5, v6
    return v7
}
; run: %saddof_combine_rev(1, 2) == 2
; run: %saddof_combine_rev(-1, 1) == -1
; run: %saddof_combine_rev(2147483647, 1) == 2147483646
; run: %saddof_combine_rev(-2147483648, -1) == 2147483645

; Both outputs are consumed well after the instruction, with unrelated work
; in between: whichever output is delivered to the next instruction by the
; encoding must be bridged (echoed) across the gap. Computes
; wrap(a+b) + flag + c - 7.
function %saddof_late(i32 sext, i32 sext, i32 sext) -> i32 sext {
block0(v0: i32, v1: i32, v2: i32):
    v3, v4 = sadd_overflow v0, v1
    v5 = iconst.i32 3
    v6 = iadd v2, v5
    v7 = iconst.i32 10
    v8 = isub v6, v7
    v9 = sextend.i32 v4
    v10 = iadd v3, v9
    v11 = iadd v10, v8
    return v11
}
; run: %saddof_late(1, 2, 7) == 3
; run: %saddof_late(10, 20, 0) == 23
; run: %saddof_late(2147483647, 1, 7) == -2147483647
; run: %saddof_late(-2147483648, -1, 107) == -2147483548

; The flag drives control flow.
function %saddof_branch(i32 sext, i32 sext) -> i32 sext {
block0(v0: i32, v1: i32):
    v2, v3 = sadd_overflow v0, v1
    brif v3, block1, block2(v2)

block1:
    v4 = iconst.i32 -1
    jump block3(v4)

block2(v5: i32):
    v6 = iconst.i32 0
    v7 = iadd v5, v6
    jump block3(v7)

block3(v8: i32):
    return v8
}
; run: %saddof_branch(1, 2) == 3
; run: %saddof_branch(2147483647, 1) == -1
; run: %saddof_branch(-2147483648, -1) == -1
; run: %saddof_branch(-4, 3) == -1

; The same operand feeds both inputs.
function %saddof_self(i32 sext) -> i32 sext, i8 uext {
block0(v0: i32):
    v1, v2 = sadd_overflow v0, v0
    return v1, v2
}
; run: %saddof_self(0) == [0, 0]
; run: %saddof_self(5) == [10, 0]
; run: %saddof_self(1073741824) == [-2147483648, 1]
; run: %saddof_self(-1073741824) == [-2147483648, 0]
; run: %saddof_self(-1073741825) == [2147483646, 1]

; Two overflow adds chained: the first's value feeds the second; the flag
; result is the sum of both flags.
function %saddof_chain(i32 sext, i32 sext, i32 sext) -> i32 sext, i8 uext {
block0(v0: i32, v1: i32, v2: i32):
    v3, v4 = sadd_overflow v0, v1
    v5, v6 = sadd_overflow v3, v2
    v7 = iadd v4, v6
    return v5, v7
}
; run: %saddof_chain(1, 2, 3) == [6, 0]
; run: %saddof_chain(2147483646, 1, 1) == [-2147483648, 1]
; run: %saddof_chain(2147483647, 1, -1) == [2147483647, 2]
; run: %saddof_chain(-1, -1, -1) == [-3, 0]

function %saddof_i16(i16 sext, i16 sext) -> i16 sext, i8 uext {
block0(v0: i16, v1: i16):
    v2, v3 = sadd_overflow v0, v1
    return v2, v3
}
; run: %saddof_i16(0, 0) == [0, 0]
; run: %saddof_i16(100, 100) == [200, 0]
; run: %saddof_i16(32767, 1) == [-32768, 1]
; run: %saddof_i16(-32768, -1) == [32767, 1]
; run: %saddof_i16(-100, 50) == [-50, 0]

function %saddof_i8(i8 sext, i8 sext) -> i8 sext, i8 uext {
block0(v0: i8, v1: i8):
    v2, v3 = sadd_overflow v0, v1
    return v2, v3
}
; run: %saddof_i8(0, 0) == [0, 0]
; run: %saddof_i8(50, 50) == [100, 0]
; run: %saddof_i8(127, 1) == [-128, 1]
; run: %saddof_i8(-128, -1) == [127, 1]
; run: %saddof_i8(-64, -64) == [-128, 0]
