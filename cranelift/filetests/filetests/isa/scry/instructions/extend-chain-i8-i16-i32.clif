test interpret
test run
target scry32

; A chain of extensions passing through the intermediate i16 type, so that a
; single value flows i8 -> i16 -> i32. Covers back-to-back Cast resolution
; where the middle size (size_pow2 == 1) is only an internal value.

function %sext_chain(i8 sext) -> i32 sext {
block0(v0: i8):
    v1 = sextend.i16 v0
    v2 = sextend.i32 v1
    return v2
}
; run: %sext_chain(0) == 0
; run: %sext_chain(-1) == -1
; run: %sext_chain(-128) == -128
; run: %sext_chain(127) == 127

function %uext_chain(i8 uext) -> i32 uext {
block0(v0: i8):
    v1 = uextend.i16 v0
    v2 = uextend.i32 v1
    return v2
}
; run: %uext_chain(0) == 0
; run: %uext_chain(255) == 255
; run: %uext_chain(128) == 128
