test interpret
test run
target scry32

; Ordered comparisons on the narrow i8 type, using operands whose i8 bit
; pattern flips sign (e.g. 200 == -56 as i8) so a wrong operand width or
; signedness changes the result.

function %slt_i8(i8 sext, i8 sext) -> i32 uext {
block0(v0: i8, v1: i8):
    v2 = icmp slt v0, v1
    v3 = uextend.i32 v2
    return v3
}
; run: %slt_i8(1, 2) == 1
; run: %slt_i8(2, 1) == 0
; run: %slt_i8(-56, 100) == 1
; run: %slt_i8(100, -56) == 0
; run: %slt_i8(-128, 127) == 1

function %ult_i8(i8 uext, i8 uext) -> i32 uext {
block0(v0: i8, v1: i8):
    v2 = icmp ult v0, v1
    v3 = uextend.i32 v2
    return v3
}
; run: %ult_i8(1, 2) == 1
; run: %ult_i8(2, 1) == 0
; run: %ult_i8(100, 200) == 1
; run: %ult_i8(200, 100) == 0
; run: %ult_i8(0, 255) == 1
