test interpret
test run
target scry32

function %sub_one_i8(i8 sext) -> i8 sext{
block1(v0: i8):
	v1 = iconst.i8 1
    v2 = isub v0, v1
    return v2
}
; run: %sub_one_i8(0) == -1
; run: %sub_one_i8(100) == 99
; run: %sub_one_i8(-10) == -11
; run: %sub_one_i8(-128) == 127

function %sub_two(i32 sext) -> i32 sext{
block1(v0: i32):
	v1 = iconst.i32 2
    v2 = isub v0, v1
    return v2
}
; run: %sub_two(0) == -2
; run: %sub_two(100) == 98
; run: %sub_two(-10) == -12
; run: %sub_two(-2147483648) == 2147483646
