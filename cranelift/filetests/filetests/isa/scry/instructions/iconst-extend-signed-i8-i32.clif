test interpret
test run
target scry32

function %add_to_const_signed(i8) -> i32 {
block0(v0: i8):
	v1 = iconst.i8 -1
	v2 = iadd v0,v1
	v3 = sextend.i32 v2
    return v3
}

; run: %add_to_const_signed(0) == -1
; run: %add_to_const_signed(10) == 9
; run: %add_to_const_signed(-1) == -2
; run: %add_to_const_signed(-128) == 127
