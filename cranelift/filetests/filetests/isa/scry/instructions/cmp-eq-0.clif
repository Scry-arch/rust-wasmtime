test interpret
test run
target scry32

function %zero_add_one(i32 uext) -> i32 uext {
block0(v0: i32):
	v1 = icmp_imm eq v0, 0
    brif v1, block2(v0), block3(v0)

block2(v2: i32):
    v3 = iadd_imm v2, 1
    jump block4(v3)

block3(v4: i32):
    v5 = iadd_imm v4, 4
    jump block4(v5)

block4(v6: i32):
    return v6
}

; run: %zero_add_one(0) == 1
; run: %zero_add_one(16) == 20
; run: %zero_add_one(-100) == -96
