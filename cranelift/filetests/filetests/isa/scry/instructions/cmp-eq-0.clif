test interpret
test run
target scry32

function %zero_add_one(i32 uext) -> i32 uext {
block0(v0: i32):
    v20 = iconst.i32 0
    v1 = icmp eq v0, v20
    brif v1, block2(v0), block3(v0)

block2(v2: i32):
    v21 = iconst.i32 1
    v3 = iadd v2, v21
    jump block4(v3)

block3(v4: i32):
    v22 = iconst.i32 4
    v5 = iadd v4, v22
    jump block4(v5)

block4(v6: i32):
    return v6
}

; run: %zero_add_one(0) == 1
; run: %zero_add_one(16) == 20
; run: %zero_add_one(-100) == -96
