test interpret
test run
target scry32

; Ordered comparisons (signed and unsigned less-than / greater-than). The
; asymmetric run cases (a<b vs b<a) pin down the operand order, and using both
; signed and unsigned operands covers the signedness-refinement path.

function %slt(i32 sext, i32 sext) -> i32 uext {
block0(v0: i32, v1: i32):
    v2 = icmp slt v0, v1
    v3 = uextend.i32 v2
    return v3
}
; run: %slt(1, 2) == 1
; run: %slt(2, 1) == 0
; run: %slt(2, 2) == 0
; run: %slt(-1, 0) == 1
; run: %slt(0, -1) == 0

function %ult(i32 uext, i32 uext) -> i32 uext {
block0(v0: i32, v1: i32):
    v2 = icmp ult v0, v1
    v3 = uextend.i32 v2
    return v3
}
; run: %ult(1, 2) == 1
; run: %ult(2, 1) == 0
; run: %ult(0, 4294967295) == 1
; run: %ult(4294967295, 0) == 0

function %sgt(i32 sext, i32 sext) -> i32 uext {
block0(v0: i32, v1: i32):
    v2 = icmp sgt v0, v1
    v3 = uextend.i32 v2
    return v3
}
; run: %sgt(2, 1) == 1
; run: %sgt(1, 2) == 0
; run: %sgt(0, -1) == 1
; run: %sgt(-1, 0) == 0

function %ugt(i32 uext, i32 uext) -> i32 uext {
block0(v0: i32, v1: i32):
    v2 = icmp ugt v0, v1
    v3 = uextend.i32 v2
    return v3
}
; run: %ugt(2, 1) == 1
; run: %ugt(1, 2) == 0
; run: %ugt(4294967295, 0) == 1
; run: %ugt(0, 4294967295) == 0

; i8 signed less-than, to cover ordered comparison at a non-word size.
function %slt_i8(i8 sext, i8 sext) -> i8 uext {
block0(v0: i8, v1: i8):
    v2 = icmp slt v0, v1
    return v2
}
; run: %slt_i8(-128, 127) == 1
; run: %slt_i8(127, -128) == 0
