test interpret
test run
target scry32

function %add_to_const_unsigned(i32 uext) -> i32 uext {
block0(v0: i32):
	v1 = iconst.i8 255
	v2 = uextend.i32 v1
	v3 = iadd v0,v2
    return v3
}

; run: %add_to_const_unsigned(0) == 255
; run: %add_to_const_unsigned(10) == 265
; run: %add_to_const_unsigned(186) == 441
