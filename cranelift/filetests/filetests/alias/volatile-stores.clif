test optimize precise-output
set opt_level=speed
target x86_64

;; Stores with the `volatile` flag, as used for memory-mapped I/O. Writing a
;; device register has an effect even when the value is overwritten right away
;; or equals the value already there, so every volatile store must be performed
;; exactly as written: it is never removed as a dead store and never removed as
;; an idempotent store.

;; Two volatile stores of different values to one address are both performed,
;; for example sending two bytes through a transmit register.
function %volatile_store_twice(i64, i32, i32) {
block0(v0: i64, v1: i32, v2: i32):
    store.i32 notrap aligned volatile v1, v0
    store.i32 notrap aligned volatile v2, v0
    return
}

; function %volatile_store_twice(i64, i32, i32) fast {
; block0(v0: i64, v1: i32, v2: i32):
;     store notrap aligned volatile v1, v0
;     store notrap aligned volatile v2, v0
;     return
; }

;; The same, when both stores are in an alias region.
function %volatile_store_twice_region(i64, i32, i32) {
    region0 = 0 "mmio"
block0(v0: i64, v1: i32, v2: i32):
    store.i32 notrap aligned volatile region0 v1, v0+4
    store.i32 notrap aligned volatile region0 v2, v0+4
    return
}

; function %volatile_store_twice_region(i64, i32, i32) fast {
;     region0 = 0 "mmio"
;
; block0(v0: i64, v1: i32, v2: i32):
;     store notrap aligned volatile region0 v1, v0+4
;     store notrap aligned volatile region0 v2, v0+4
;     return
; }

;; A chain of byte-wide volatile stores is kept in full.
function %volatile_istore8_chain(i64, i32, i32, i32) {
block0(v0: i64, v1: i32, v2: i32, v3: i32):
    istore8 notrap volatile v1, v0+4
    istore8 notrap volatile v2, v0+4
    istore8 notrap volatile v3, v0+4
    return
}

; function %volatile_istore8_chain(i64, i32, i32, i32) fast {
; block0(v0: i64, v1: i32, v2: i32, v3: i32):
;     istore8 notrap volatile v1, v0+4
;     istore8 notrap volatile v2, v0+4
;     istore8 notrap volatile v3, v0+4
;     return
; }

;; Storing the same value twice performs both stores.
function %volatile_store_same_value_twice(i64, i32) {
block0(v0: i64, v1: i32):
    store.i32 notrap aligned volatile v1, v0
    store.i32 notrap aligned volatile v1, v0
    return
}

; function %volatile_store_same_value_twice(i64, i32) fast {
; block0(v0: i64, v1: i32):
;     store notrap aligned volatile v1, v0
;     store notrap aligned volatile v1, v0
;     return
; }

;; Writing back the value just read from a register is kept, for example to
;; acknowledge the interrupt flags that are set in a status register.
function %volatile_store_back_volatile_load(i64) {
block0(v0: i64):
    v1 = load.i32 notrap aligned volatile v0
    store.i32 notrap aligned volatile v1, v0
    return
}

; function %volatile_store_back_volatile_load(i64) fast {
; block0(v0: i64):
;     v1 = load.i32 notrap aligned volatile v0
;     store notrap aligned volatile v1, v0
;     return
; }

;; A volatile store of the value an ordinary load just read is not an
;; idempotent store.
function %volatile_store_back_plain_load(i64) {
block0(v0: i64):
    v1 = load.i32 notrap aligned v0
    store.i32 notrap aligned volatile v1, v0
    return
}

; function %volatile_store_back_plain_load(i64) fast {
; block0(v0: i64):
;     v1 = load.i32 notrap aligned v0
;     store notrap aligned volatile v1, v0
;     return
; }

;; A volatile store is not made dead by a later ordinary store to the same
;; address.
function %volatile_store_then_plain_store(i64, i32, i32) {
block0(v0: i64, v1: i32, v2: i32):
    store.i32 notrap aligned volatile v1, v0
    store.i32 notrap aligned v2, v0
    return
}

; function %volatile_store_then_plain_store(i64, i32, i32) fast {
; block0(v0: i64, v1: i32, v2: i32):
;     store notrap aligned volatile v1, v0
;     store notrap aligned v2, v0
;     return
; }

;; A volatile store in a block that post-dominates another volatile store to the
;; same address does not make the first one dead.
function %volatile_store_post_dominated(i64, i32, i32) {
block0(v0: i64, v1: i32, v2: i32):
    store.i32 notrap aligned volatile v1, v0
    jump block1

block1:
    store.i32 notrap aligned volatile v2, v0
    return
}

; function %volatile_store_post_dominated(i64, i32, i32) fast {
; block0(v0: i64, v1: i32, v2: i32):
;     store notrap aligned volatile v1, v0
;     jump block1
;
; block1:
;     store.i32 notrap aligned volatile v2, v0
;     return
; }
