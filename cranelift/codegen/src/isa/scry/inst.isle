(type RegVec (primitive RegVec))
(type WritableRegVec (primitive WritableRegVec))
(type U16Vec (primitive U16Vec))
(type MachLabelVec (primitive MachLabelVec))
(type AluVariant (primitive AluVariant))
(type Alu2Variant (primitive Alu2Variant))
(type Alu2OutputVariant (primitive Alu2OutputVariant))
(type IsaType (primitive IsaType))
(type Signature (primitive Signature))

(decl gen_machlabel (MachLabelSlice) MachLabel)
(extern constructor gen_machlabel gen_machlabel)

(type ResizeVariant
  (enum
    (Uextend) ;; Unsigned extend
    (Sextend) ;; Signed extend
    (Reduce)  ;; Reduce
  )
)

(type UnaryAluOp
  (enum
    (LogNeg)    ;; Logical negation
  )
)

(type BinaryAluOp
  (enum
    (IntAddWrap)    ;; Integer wrapping addition
    (IntSubWrap)    ;; Integer wrapping subtraction
    (IntMulWrap)    ;; Integer wrapping multiplication (the low product half)
    (BitAnd)        ;; Bitwise AND
    (BitOr)         ;; Bitwise OR
    (BitXor)        ;; Bitwise XOR
  )
)

(type DoubleAluOp
  (enum
    (SaddOverflow)  ;; Signed wrapping addition + signed-overflow flag
    (UaddOverflow)  ;; Unsigned wrapping addition + carry flag
    (UsubOverflow)  ;; Unsigned wrapping subtraction + borrow flag
    (SsubOverflow)  ;; Signed wrapping subtraction + signed-overflow flag
    (UmulHi)        ;; Unsigned full multiplication (the high half is used)
    (SmulHi)        ;; Signed full multiplication (the high half is used)
    (UdivRem)       ;; Unsigned division: quotient (low) + remainder (high)
    (SdivRem)       ;; Signed Euclidean division: quotient (low) + remainder
                    ;; (high); CLIF's truncating semantics are recovered by
                    ;; the fix-up in `lower_sdiv`/`lower_srem`
  )
)

;; Instruction formats.
(type MInst
  (enum
    ;; A no-op.
    (Nop)

    ;; Discards any incoming operands
    (Discard
      (rss RegVec)
    )

    ;; A pseudo-instruction that captures register arguments in vregs.
    (Args
      (args VecArgPair)
    )

    ;; A pseudo-instruction that moves vregs to return registers.
    (Rets
      (rets VecRetPair)
    )

    (UnaryAlu           ; 1 input, 1 output ALU instruction
      (op UnaryAluOp)
      (rd WritableReg)
      (rs Reg)
    )

    (BinaryAlu          ; 2 input, 1 output ALU instruction using effective input types
      (op BinaryAluOp)
      (rd WritableReg)
      (rs1 Reg)
      (rs2 Reg)
    )

    ;; 2-input, 2-output ALU pseudo-instruction; resolved to a two-output
    ;; Alu2 after type analysis.
    (DoubleAlu
      (op DoubleAluOp)
      (rdl WritableReg) ;; The machine's low output (e.g. the value result)
      (rdh WritableReg) ;; The machine's high output (e.g. the flag result)
      (rs1 Reg)
      (rs2 Reg)
    )

    (IntCmp
      (cc IntCC)
      (rd WritableReg)
      (rs1 Reg)
      (rs2 Reg)
    )

    ;; Logical negation pseudo-instruction: rd = (rs == 0) as u8. Resolved to
    ;; the machine's single-operand `eq`, whose implicit second operand is 0.
    ;; Used to synthesize the comparisons the machine lacks (ne, le, ge) as
    ;; the negation of the opposite comparison.
    (LogicalNot
      (rd WritableReg)
      (rs Reg)
    )

    (Resize
      (var ResizeVariant)
      (rd WritableReg)
      (rs Reg)
    )

    (Ret
      (trig u16) ;; Trigger location, ready to encode
    )

    ;; Call instruction
    (Call
      (link WritableReg) ;; Links to the trigger pseudo-instruction, not actually used
      (fun Reg)          ;; Address to call
      (trig u16)         ;; Trigger location, ready to encode
    )

    ;; Pseudo-instruction at a call trigger position
    (CallArgs
      (link Reg)         ;; Link to the call instruction, not actually used
      (rets CallRetList) ;; Return operands
      (args CallArgList) ;; call arguments
      (sig Signature)    ;; Signature of the called function
    )

    (Const
      (ty IsaType)
      (rd WritableReg)
      (imm Imm64)
    )

    ;; Represents the absolute address of an external label as a
    ;; const + grow chain whose immediates are filled in by a ScryAbs32
    ;; relocation.
    (LoadExtName
      (rd WritableReg)
      (name BoxExternalName)
    )

    ;; General-purpose echoing, does not reflect a Scry echo instruction 1-to-1
    (Echo
      (rds WritableRegVec)
      (rss RegVec)
    )

    ;; An echo that output the first two operands and send the rest to the next instruction
    ;; This maps to the splitting echo in Scry. Remember that it flips the order of the first two operands
    ;; if they have the same reference
    (EchoChain
      (rd1 WritableReg)
      (rd2 WritableReg)
      (rs1 Reg)
      (rs2 Reg)
      (out1 u16)
      (out2 u16)
      (rd_chain WritableRegVec)
      (rs_chain RegVec)
    )

    ;; An echo takes two operands and outputs them to each their target
    ;;
    ;; Maps to the scry splitting echo. However, if the references are equal, maps to the long echo to ensure
    ;; their order is not flipped (as the splitting echo does).
    (EchoSplit
      (rd1 WritableReg)
      (rd2 WritableReg)
      (rs1 Reg)
      (rs2 Reg)
      (out1 u16)
      (out2 u16)
    )

    ;; An echo takes any number of operands and outputs them to the same target
    (EchoLong
      (rds WritableRegVec)
      (rss RegVec)
      (out u16)
    )

    ;; Reorder the two inputs to the same output
    ;;
    ;; In the input, rs1 is first and rs2 is second.
    ;; In the output rd1 is first and rd2 is second.
    ;; The of rs1 goes to rd2 and rs2 -> rd1.
    (Reorder
      (rd1 WritableReg)
      (rd2 WritableReg)
      (rs1 Reg)
      (rs2 Reg)
      (out u16) ;; Output reference
    )

    (Duplicate
      (rd1 WritableReg)
      (rd2 WritableReg)
      (rs Reg)
      (out1 u16) ;; Output reference
      (out2 u16) ;; Output reference
    )

    (Store
      (rs Reg) ;; value to store
      (rd Reg) ;; Address to store to
    )

    (Load
      (ty IsaType)     ;; Type of loaded value
      (rd WritableReg) ;; Loaded value
      (rs Reg)         ;; Address to load from
      (out u16)        ;; Output reference
    )

    ;; Store to the stack frame. The store address is scale*idx from the
    ;; frame base, where the scale is the size of the stored value.
    (StoreStack
      (rs Reg)  ;; value to store
      (idx u16) ;; Stack index to store at
    )

    ;; Pseudo-instruction: a store of a stack-passed call argument (the 5th
    ;; onward, see the ABI's calling convention) into the outgoing argument
    ;; area, i.e. the shared frame set up for the next call. The offset is
    ;; relative to that area's base; `lower_stack_args` resolves it against
    ;; the function's own private frame size into a concrete stack access.
    (StoreStackArg
      (rs Reg)          ;; value to store
      (offset u16)      ;; byte offset within the outgoing argument area
      (scale_pow2 u16)  ;; power-of-two scale of the stored type
    )

    ;; Load from the stack frame. The load address is scale*idx from the
    ;; frame base, where the scale is the size of the loaded type.
    (LoadStack
      (ty IsaType)     ;; Type of loaded value
      (rd WritableReg) ;; Loaded value
      (idx u16)        ;; Stack index to load from
    )

    ;; Address of a stack frame location: frame base + scale*idx. The
    ;; result is always delivered to the next instruction (the encoding has no
    ;; output reference) and is typed by the machine as an unsigned integer of
    ;; its pointer size.
    (SAddr
      (rd WritableReg)  ;; Resulting address
      (scale_pow2 u16)  ;; Power-of-two scale of the indexed unit
      (idx u16)         ;; Stack index
    )

    ;; Reserve or free stack frame bytes (rsrv/free). Reserves target the
    ;; private frame; frees target the shared frame, which releases the memory
    ;; (freeing the private frame would only merge it into the shared frame).
    (StackAdjust
      (reserve bool)    ;; true = reserve, false = free
      (private bool)    ;; true = private frame, false = shared frame
      (amount_pow2 u16) ;; 2^amount_pow2 bytes
    )

    (Cast
      (rd WritableReg)
      (ty IsaType)
      (rs Reg)
      (out u16)        ;; Output reference
    )

    (ImmJump           ;; A unconditional immediate jump
      (dst MachLabel)
    )

    ;; Issues a unconditional jump
    (JumpIssue
      (link WritableReg) ;; Links to the trigger instruction, not actually used
      (dst MachLabel)  ;; Where to jump to
      (trig u16)       ;; Trigger offset
    )

    ;; Issues a conditional branch
    (BranchIssue
      (link WritableReg) ;; Links to the trigger instruction, not actually used
      (dst MachLabel)    ;; Where to jump to
      (dir bool)         ;; Whether jumping forwards or backwards
      (cond Reg)         ;; Condition
      (trig u16)         ;; Trigger offset
    )

    ;; The point at which the control flow issued by the preceding issues takes
    ;; effect, and where the block call arguments are delivered. Emits nothing.
    ;;
    ;; A block may hold several issues sharing one trigger, such that the
    ;; branching trigger at the same location regardless of which branch is taken.
    ;; Such a group of issues and a trigger will all use the same link register.
    (JumpTrigger
      (link Reg)          ;; Links to the issue instructions, not actually used
      (args RegVec)       ;; Block call arguments
    )

    ;; Single-output ALU instructions
    (Alu1
      (var AluVariant)
      (rd WritableReg)
      (rss RegVec)
      (out u16) ;; Output reference
    )

    ;; Single-output ALU instructions
    (Alu2
      (var Alu2Variant)
      (out_var Alu2OutputVariant)
      (rds WritableRegVec)
      (rss RegVec)
      (outs U16Vec) ;; Output reference
    )
  )
)

;;
;; Instruction-specific lowerings
;;

(decl isatype_invalid () IsaType)
(extern constructor isatype_invalid isatype_invalid)

(decl const_r (Type Imm64) Reg)
(rule
  (const_r ty imm)
  (let
    ( (dst WritableReg (temp_writable_reg ty))
      (_ Unit (emit (MInst.Const (isatype_invalid) dst imm)))
    )
    dst
  )
)

(decl add_trrr (Type Reg Reg) Reg)
(rule
  (add_trrr ty src1 src2)
  (let
    ( (dst WritableReg (temp_writable_reg ty))
      (_ Unit (emit (MInst.BinaryAlu (BinaryAluOp.IntAddWrap)  dst src1 src2)))
    )
    dst
  )
)

(decl sadd_overflow_rrr (Type Reg Reg) InstOutput)
(rule
  (sadd_overflow_rrr ty x y)
  (let
    ( (rdl WritableReg (temp_writable_reg ty))
      (rdh WritableReg (temp_writable_reg $I8))
      (_ Unit (emit (MInst.DoubleAlu (DoubleAluOp.SaddOverflow) rdl rdh x y)))
    )
    (output_pair (value_reg rdl) (value_reg rdh))
  )
)

(decl isub_wrap_trrr (Type Reg Reg) Reg)
(rule
  (isub_wrap_trrr ty lhs rhs)
  (let
    ( (dst WritableReg (temp_writable_reg ty))
      (_ Unit (emit (MInst.BinaryAlu (BinaryAluOp.IntSubWrap)  dst lhs rhs)))
    )
    dst
  )
)

;; Generic single-output binary ALU operation.
(decl balu_otrr (BinaryAluOp Type Reg Reg) Reg)
(rule
  (balu_otrr op ty lhs rhs)
  (let
    ( (dst WritableReg (temp_writable_reg ty))
      (_ Unit (emit (MInst.BinaryAlu op dst lhs rhs)))
    )
    dst
  )
)

;; Generic two-output ALU operation returning the value + flag pair
;; (the overflow family; the flag is the machine's high output).
(decl dalu_overflow_otrr (DoubleAluOp Type Reg Reg) InstOutput)
(rule
  (dalu_overflow_otrr op ty x y)
  (let
    ( (rdl WritableReg (temp_writable_reg ty))
      (rdh WritableReg (temp_writable_reg $I8))
      (_ Unit (emit (MInst.DoubleAlu op rdl rdh x y)))
    )
    (output_pair (value_reg rdl) (value_reg rdh))
  )
)

;; Generic two-output ALU operation of which only the LOW output is used;
;; the dead high output is dropped by the dead-output handling later.
(decl dalu_low_otrr (DoubleAluOp Type Reg Reg) Reg)
(rule
  (dalu_low_otrr op ty x y)
  (let
    ( (rdl WritableReg (temp_writable_reg ty))
      (rdh WritableReg (temp_writable_reg ty))
      (_ Unit (emit (MInst.DoubleAlu op rdl rdh x y)))
    )
    rdl
  )
)

;; Generic two-output ALU operation of which only the HIGH output is used;
;; the dead low output is dropped by the dead-output handling later.
(decl dalu_high_otrr (DoubleAluOp Type Reg Reg) Reg)
(rule
  (dalu_high_otrr op ty x y)
  (let
    ( (rdl WritableReg (temp_writable_reg ty))
      (rdh WritableReg (temp_writable_reg ty))
      (_ Unit (emit (MInst.DoubleAlu op rdl rdh x y)))
    )
    rdh
  )
)

;; Signed division/remainder with CLIF's truncating semantics, built from the
;; machine's Euclidean division plus a fix-up (implemented in Rust).
(decl lower_sdiv (Type Reg Reg) Reg)
(extern constructor lower_sdiv lower_sdiv)
(decl lower_srem (Type Reg Reg) Reg)
(extern constructor lower_srem lower_srem)

(decl icmp_tcrrr (Type IntCC Reg Reg) Reg)
(rule
  (icmp_tcrrr ty cc lhs rhs)
  (let
    ( (dst WritableReg (temp_writable_reg ty))
      (_ Unit (emit (MInst.IntCmp cc dst lhs rhs)))
    )
    dst
  )
)

;; The negation of a comparison: used for the condition codes the machine has
;; no direct operation for.
(decl icmp_not_tcrrr (Type IntCC Reg Reg) Reg)
(rule
  (icmp_not_tcrrr ty cc lhs rhs)
  (let
    ( (flag Reg (icmp_tcrrr ty cc lhs rhs))
      (dst WritableReg (temp_writable_reg $I8))
      (_ Unit (emit (MInst.LogicalNot dst flag)))
    )
    dst
  )
)

(decl resize_vrr (ResizeVariant Type Reg) Reg)
(rule
  (resize_vrr var ty rs)
  (let
    ( (dst WritableReg (temp_writable_reg ty))
      (_ Unit (emit (MInst.Resize var dst rs)))
    )
    dst
  )
)

(decl st_rrfo (Reg Reg MemFlags Imm64) InstOutput)

; Catches stores with non-zero offsets
(rule 10
  (st_rrfo val dst flags (nonzero_imm64 off))
  (let
    ( (offset_r Reg (const_r $I32 off))
      (dst_off_r Reg (add_trrr $I32 offset_r dst))
    )
    (side_effect (SideEffectNoResult.Inst (MInst.Store val dst_off_r)))
  )
)

; Catches stores with zero offsets
(rule 0
  (st_rrfo val dst flags _)
  (side_effect (SideEffectNoResult.Inst (MInst.Store val dst)))
)

; Gets the full signature of the given sigref
(decl get_signature (SigRef) Signature)
(extern constructor get_signature get_signature)

; Materializes the absolute address of an external function.
(decl load_ext_name (BoxExternalName) Reg)
(rule
  (load_ext_name name)
  (let
    ( (dst WritableReg (temp_writable_reg $I32))
      (_ Unit (emit (MInst.LoadExtName dst name)))
    )
    dst
  )
)

(decl call_ind_srv (SigRef Reg ValueRegsVec) ValueRegsVec)
(rule
  (call_ind_srv sig_ref ptr args)
  (let
    ( (call_trig_link WritableReg (temp_writable_reg $I64))
      (output ValueRegsVec (gen_call_output sig_ref))
      (abi Sig (abi_sig sig_ref))
      (sig Signature (get_signature sig_ref))
      (uses CallArgList (gen_call_args abi args))
      (defs CallRetList (gen_call_rets abi output))
      (_ Unit (emit (MInst.Call call_trig_link ptr 0)))
      (_ Unit (emit (MInst.CallArgs call_trig_link defs uses sig)))
    )
    output
  )
)


; Accepts only non-zero Imm64
(decl nonzero_imm64 (Imm64) Imm64)
(extern extractor nonzero_imm64 nonzero_imm64)

(decl ld_trfo (Type Reg MemFlags Imm64) Reg)

; Catches loads with non-zero offsets
(rule 10
  (ld_trfo ty ptr flags (nonzero_imm64 off))
  (let
    (
      (offset_r Reg (const_r $I32 off))
      (ptr_off_r Reg (add_trrr $I32 offset_r ptr))
      (dst WritableReg (temp_writable_reg ty))
      (_ Unit (emit (MInst.Load (isatype_invalid) dst ptr_off_r 0)))
    )
    dst
  )
)

; Catches loads with zero offsets
(rule 0
  (ld_trfo ty ptr flags _)
  (let
    (
      (dst WritableReg (temp_writable_reg ty))
      (_ Unit (emit (MInst.Load (isatype_invalid) dst ptr 0)))
    )
    dst
  )
)

;;
;;(decl mat_imm_i64 (Value) Reg)
;;(extern constructor mat_imm_i64 mat_imm_i64)

;; cranelift/codegen/src/isa/scry/inst.isle
;; Types like InstOutput and Unit come from the shared prelude built into Cranelift’s ISLE build.


;; Materializes the address of a stack slot location (saddr + cast).
(decl lower_stack_addr (StackSlot Offset32) Reg)
(extern constructor lower_stack_addr lower_stack_addr)

;; Loads from a stack slot location, using ld.s when the frame offset can be
;; expressed as a scaled index, and saddr + a plain load otherwise.
(decl lower_stack_load (Type StackSlot Offset32 Offset32) Reg)
(extern constructor lower_stack_load lower_stack_load)

;; Stores to a stack slot location, using st.s when the frame offset can be
;; expressed as a scaled index, and saddr + a plain store otherwise.
(decl lower_stack_store (Value StackSlot Offset32 Offset32) InstOutput)
(extern constructor lower_stack_store lower_stack_store)

;; Emits return instruction
(decl emit_ret (ValueSlice) InstOutput)
(extern constructor emit_ret emit_ret)

;; (1) Declare the ISLE signatures:
(decl emit_nop_and_empty () InstOutput)
(decl emit_nop_unit () Unit)

;; (2) Bind to the Rust functions you wrote in lower.rs:
(extern constructor emit_nop_and_empty emit_nop_and_empty)
(extern constructor emit_nop_unit emit_nop_unit)


;; Fallback function for when lowering rules caught the instruction
(decl lower_error (Inst) InstOutput)
(decl lower_branch_error (Inst MachLabelSlice) Unit)

(extern constructor lower_error lower_error)
(extern constructor lower_branch_error lower_branch_error)


