;; scry instruction selection and CLIF-to-MachInst lowering.




;; These are the standard lowering entry points (see x64’s file for reference).
(decl partial lower (Inst) InstOutput)
(decl partial lower_branch (Inst MachLabelSlice) Unit)


(rule
    (lower (iconst ty imm))
    (const_r ty imm)
)

(rule
    (lower (iadd ty lhs rhs))
    (add_trrr ty lhs rhs)
)

(rule
    (lower (isub ty lhs rhs))
    (isub_wrap_trrr ty lhs rhs)
)

(rule
    (lower (sadd_overflow ty lhs rhs))
    (sadd_overflow_rrr ty lhs rhs)
)

(rule
    (lower (uadd_overflow ty lhs rhs))
    (dalu_overflow_otrr (DoubleAluOp.UaddOverflow) ty lhs rhs)
)

(rule
    (lower (usub_overflow ty lhs rhs))
    (dalu_overflow_otrr (DoubleAluOp.UsubOverflow) ty lhs rhs)
)

(rule
    (lower (ssub_overflow ty lhs rhs))
    (dalu_overflow_otrr (DoubleAluOp.SsubOverflow) ty lhs rhs)
)

(rule
    (lower (band ty lhs rhs))
    (balu_otrr (BinaryAluOp.BitAnd) ty lhs rhs)
)

(rule
    (lower (bor ty lhs rhs))
    (balu_otrr (BinaryAluOp.BitOr) ty lhs rhs)
)

(rule
    (lower (bxor ty lhs rhs))
    (balu_otrr (BinaryAluOp.BitXor) ty lhs rhs)
)

;; The low product half is signedness-agnostic, like wrapping add/sub.
(rule
    (lower (imul ty lhs rhs))
    (balu_otrr (BinaryAluOp.IntMulWrap) ty lhs rhs)
)

(rule
    (lower (umulhi ty lhs rhs))
    (dalu_high_otrr (DoubleAluOp.UmulHi) ty lhs rhs)
)

(rule
    (lower (smulhi ty lhs rhs))
    (dalu_high_otrr (DoubleAluOp.SmulHi) ty lhs rhs)
)

(rule
    (lower (udiv ty lhs rhs))
    (dalu_low_otrr (DoubleAluOp.UdivRem) ty lhs rhs)
)

(rule
    (lower (urem ty lhs rhs))
    (dalu_high_otrr (DoubleAluOp.UdivRem) ty lhs rhs)
)

(rule
    (lower (sdiv ty lhs rhs))
    (lower_sdiv ty lhs rhs)
)

(rule
    (lower (srem ty lhs rhs))
    (lower_srem ty lhs rhs)
)

(rule
    (lower (icmp ty cc lhs rhs))
    (icmp_tcrrr ty cc lhs rhs)
)

;; The machine only has eq, lt, and gt; the remaining condition codes are the
;; negation of the opposite comparison (operand order preserved).
(rule 1
    (lower (icmp ty (IntCC.NotEqual) lhs rhs))
    (icmp_not_tcrrr ty (IntCC.Equal) lhs rhs)
)

(rule 1
    (lower (icmp ty (IntCC.SignedLessThanOrEqual) lhs rhs))
    (icmp_not_tcrrr ty (IntCC.SignedGreaterThan) lhs rhs)
)

(rule 1
    (lower (icmp ty (IntCC.UnsignedLessThanOrEqual) lhs rhs))
    (icmp_not_tcrrr ty (IntCC.UnsignedGreaterThan) lhs rhs)
)

(rule 1
    (lower (icmp ty (IntCC.SignedGreaterThanOrEqual) lhs rhs))
    (icmp_not_tcrrr ty (IntCC.SignedLessThan) lhs rhs)
)

(rule 1
    (lower (icmp ty (IntCC.UnsignedGreaterThanOrEqual) lhs rhs))
    (icmp_not_tcrrr ty (IntCC.UnsignedLessThan) lhs rhs)
)

(rule
    (lower (uextend ty rs))
    (resize_vrr (ResizeVariant.Uextend) ty rs)
)

(rule
    (lower (sextend ty rs))
    (resize_vrr (ResizeVariant.Sextend)  ty rs)
)

(rule
    (lower (ireduce ty rs))
    (resize_vrr (ResizeVariant.Reduce)  ty rs)
)

(rule
    (lower (store flags val dst (imm64_from_offset off)))
    (st_rrfo val dst flags off)
)

;; Accesses whose address comes directly from a stack_addr use the dedicated
;; stack instructions (st.s/ld.s) where possible instead of materializing the
;; address.
(rule 10
    (lower (store flags val (stack_addr _ ss slot_off) off))
    (lower_stack_store val ss slot_off off)
)

(rule 10
    (lower (load ty flags (stack_addr _ ss slot_off) off))
    (lower_stack_load ty ss slot_off off)
)

(rule
    (lower (stack_addr ty ss off))
    (lower_stack_addr ss off)
)

(rule
    (lower (call_indirect sig_ref ptr args))
    (call_ind_srv sig_ref ptr args)
)

;; A direct call materializes the callee's address (via relocation) and then
;; behaves exactly like an indirect call: the address is an unsigned value,
;; which the machine's call instruction treats as absolute.
(rule
    (lower (call (func_ref_data sig_ref name _ _) args))
    (call_ind_srv sig_ref (load_ext_name name) args)
)

(rule
    (lower (func_addr ty (func_ref_data _ name _ _)))
    (load_ext_name name)
)

(decl imm64_from_offset (Imm64) Offset32)
(extern extractor infallible imm64_from_offset imm64_from_offset)

(rule
    (lower (load ty flags ptr (imm64_from_offset offset)))
    (ld_trfo ty ptr flags offset)
)

;; Helper to extract register arguments from BlockCall
(decl block_call_regs (BlockCall) RegVec)
(extern constructor block_call_regs block_call_regs)

;; Note on JumpTrigger args in the rules below: they are provisional. The final
;; args (the unified wire order covering all successors, possibly differing per
;; target) are recomputed from the blocks' branch parameter order in
;; `prepare_block_params`, which overwrites the args of every JumpTrigger.

;; Lower unconditional jump
(rule
    (lower_branch (jump block_call) targets)
    (let
      ( (jmp_trig_link WritableReg (temp_writable_reg $I64))
        (_ Unit (emit (MInst.JumpIssue jmp_trig_link (gen_machlabel targets) 0)))
      )
      (emit_side_effect
        (SideEffectNoResult.Inst
          (MInst.JumpTrigger
            jmp_trig_link
            (block_call_regs block_call)
          )
        )
      )
    )
)

;; Lower conditional jump
(rule
    (lower_branch (brif cond block_call_1 block_call_2) targets)
    (let
      ( (jmp_trig_link WritableReg (temp_writable_reg $I64))
        ; "block_call_1" is taken if "cond" is true (non-zero). Scry branch is taken on non-zero only for backward branches
        (_ Unit (emit (MInst.BranchIssue jmp_trig_link (gen_machlabel targets) false cond 0)))
      )
      (emit_side_effect
        (SideEffectNoResult.Inst
          (MInst.JumpTrigger
            jmp_trig_link
            (block_call_regs block_call_1)
          )
        )
      )
    )
)

;; Lower a jump table.
;;
;; Emitted in Rust rather than ISLE because the instruction sequence is as long
;; as the table. See `lower_br_table`.
(decl lower_br_table (Value JumpTable MachLabelSlice) Unit)
(extern constructor lower_br_table lower_br_table)

(rule
    (lower_branch (br_table idx table) targets)
    (lower_br_table idx table targets)
)

;; Lower return
(rule (lower (return args))
      (lower_return args))

;; Catch-all: match any CLIF instruction and emit a NOP (no results).
(rule -1 (lower instr) (lower_error instr))

;; Catch-all for branches: emit a NOP and return unit.
(rule -1 (lower_branch instr slice) (lower_branch_error instr slice))



